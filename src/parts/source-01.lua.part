    local upgrade_catalog_factory=(function()
-- Discover ALL native upgrade gun groups; retain their real highest-level row.
-- Metadata only. Assets are loaded only for a selected/equipped weapon.
return function(opt)
    local D={diagnostics={groups=0,weapons=0,scanned=0}}
    local queue,index,complete=nil,1,false
    local bases,seen={},{ }
    local function member(o,k)
        if o==nil then return end
        local ok,v=pcall(function() return o[k] end);if ok then return v end
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function rows(list)
        local ok,n=call(list,'Num');local result={}
        if ok and type(n)=='number' and n>=0 and n<=5000 then
            for i=0,n-1 do local got,row=call(list,'Get',i);if got then result[#result+1]=row end end
        elseif type(list)=='table' then for _,row in pairs(list) do result[#result+1]=row end end
        return result
    end
    function D.step()
        if complete then return true end
        local manager=opt.manager();if not manager then return false end
        if not queue then
            call(manager,'InitItemUpgradeConfig')
            local groups=member(manager,'itemUpgradeConfigsKeyByGroupID')
            queue={}
            if type(groups)=='table' then
                for _,group in pairs(groups) do if type(group)=='table' then queue[#queue+1]=group end end
            else
                local ok,all=call(manager,'GetAllUpgradeItemsExceptPadora')
                if ok then
                    for _,entry in ipairs(rows(all)) do
                        local got,group=call(manager,'GetUpgradeGroupByItemID',member(entry,'ItemID'))
                        if got then queue[#queue+1]=group end
                    end
                end
            end
            if #queue==0 then queue=nil;D.diagnostics.status='upgrade_catalogue_not_ready';return false end
            D.diagnostics.total_groups=#queue
        end
        for _=1,8 do
            local group=queue[index];if not group then break end;index=index+1
            local best,level,members,groupID=nil,-1,{},nil
            for _,row in ipairs(rows(group)) do
                local id,l=tonumber(member(row,'ItemID')),tonumber(member(row,'Level'))
                if id and l and l>=1 then
                    members[#members+1]=id
                    if l>level or (l==level and id>(best or 0)) then best=id;level=l;groupID=member(row,'GroupID') end
                end
            end
            if best and opt.item(best) and #members>1 and not seen[groupID or best] then
                local base=opt.base(best);local cfg=base and opt.item(base)
                if cfg and opt.is_gun(member(cfg,'ItemType')) then
                    seen[groupID or best]=true
                    local entry={base_id=base,skin_ids=members,max_id=best,level=level,group_id=groupID,
                        name=opt.name(base,cfg)}
                    opt.add(entry)
                    D.diagnostics.groups=D.diagnostics.groups+1
                    if not bases[base] then bases[base]=true;D.diagnostics.weapons=D.diagnostics.weapons+1 end
                end
            end
        end
        D.diagnostics.scanned=index-1
        if index>#queue then queue=nil;complete=true;D.diagnostics.status='complete_max_level_only'
        else D.diagnostics.status='reading_upgrade_metadata' end
        return complete
    end
    return D
end


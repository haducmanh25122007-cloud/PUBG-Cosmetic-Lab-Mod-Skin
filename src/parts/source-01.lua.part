    function V.clear()
        for vehicle,s in pairs(states) do
            if opt.valid(vehicle) and opt.valid(s.avatar) then
                call(vehicle,'PreChangeVehicleAvatar',baseBySkin[s.skin],0)
                call(s.avatar,'PreChangeVehicleAvatar',baseBySkin[s.skin])
                call(s.avatar,'ChangeItemAvatar',baseBySkin[s.skin],false)
            end

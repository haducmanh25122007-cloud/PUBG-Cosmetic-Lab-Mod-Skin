    local function member(o,k) if o==nil then return nil end;local ok,v=pcall(function() return o[k] end);if ok then return v end;return nil end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false,nil end
        return pcall(fn,o,...)
    end
    local function base(id)
        if catalog[id] then return id end
        if baseBySkin[id] then return baseBySkin[id] end
        if type(opt.base)=='function' then return opt.base(id) end
    end
    local function record(id)
        if not baseBySkin[id] then return nil end
        local cfg=opt.item(id)
        if not cfg then return nil end
        records[-id]=records[-id] or {resID=id,res_id=id,insID=-id,ins_id=-id,count=1,
            expireTS=0,lock_cnt=0,itemType=member(cfg,'ItemType'),
            itemQuality=member(cfg,'ItemQuality') or member(cfg,'Quality'),
            itemSubType=member(cfg,'ItemSubType'),__manhduathoi_vehicle=true}
        return records[-id]
    end
    function V.lists()
        if not ensure_catalog() then return {} end
        local result={}
        for kind,list in pairs(catalog) do
            result[kind]={};for _,row in ipairs(list) do result[kind][#result[kind]+1]=row.id end
            table.sort(result[kind])
        end
        return result
    end
    function V.rows(kind)
        if not ensure_catalog() then return {} end
        local result={}
        for _,entry in ipairs(catalog[base(kind)] or {}) do
            local r=record(entry.id)
            if r then
                local row={};for k,v in pairs(r) do row[k]=v end
                row.selected=opt.selected(entry.base)==entry.id
                row.model=entry.path;row.name=entry.name

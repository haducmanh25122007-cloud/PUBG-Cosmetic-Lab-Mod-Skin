    local avatar_context_factory=(function()
-- Resolve reflected UObjects; the AnimInstance offset is not a Character offset.
-- No pointer arithmetic and no UObject calls on worker threads.
return function(opt)
    local R={diagnostics={}}
    local classes={}
    local function member(o,k)
        if o==nil then return end
        local ok,v=pcall(function() return o[k] end);if ok then return v end
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function valid(o)
        local ok,v=pcall(opt.valid,o);return ok and v==true
    end
    local function component(model,className)
        local cls=classes[className]
        if cls==nil then
            local ok,v=pcall(opt.import,className)
            if ok and v then classes[className]=v;cls=v end
        end
        if cls then
            local ok,v=call(model,'GetComponentByClass',cls)
            if ok and valid(v) then return v end
        end
    end
    function R.resolve(model)
        if not valid(model) then R.diagnostics.status='avatar_model_unavailable';return end
        local avatar=member(model,'CharacterAvatarComp') or member(model,'AvatarComponent')
        local emote=member(model,'PlayEmoteComponent')
        if not valid(avatar) then
            local ok,v=call(model,'GetCharacterAvatarComp2');if ok and valid(v) then avatar=v end
        end
        if not valid(avatar) then
            local mesh=member(model,'Mesh')
            if not valid(mesh) then local ok,v=call(model,'GetMesh');if ok then mesh=v end end
            local ok,anim=call(mesh,'GetAnimInstance')
            if ok and valid(anim) then
                avatar=member(anim,'CharacterAvatarComp')
                if not valid(avatar) then local got,v=call(anim,'GetCharacterAvatarComp2');if got then avatar=v end end
            end
        end
        if not valid(avatar) then avatar=component(model,'CharacterAvatarComponent2') end
        if not valid(emote) then emote=component(model,'PlayEmoteComponent') end
        if not valid(avatar) then avatar=nil end
        if not valid(emote) then emote=nil end
        R.diagnostics.avatar_component_found=avatar~=nil
        R.diagnostics.emote_component_found=emote~=nil
        R.diagnostics.status=avatar and 'reflected_avatar_component_ready' or 'avatar_component_not_exposed'
        return avatar,emote
    end
    return R
end


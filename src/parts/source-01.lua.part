        end
        local called,result=static('WriteFileAtPath',path,payload)
        if called and result==true and read_native()==payload then
            S.diagnostics.persisted=true;S.diagnostics.write_backend='native';S.diagnostics.error=nil;return true
        end
        S.diagnostics.persisted=false;S.diagnostics.error='state_write_readback_unconfirmed';return false
    end
    for key,value in pairs(opt.defaults) do S.toggles[key]=value end
    local restored,why=S.restore();S.diagnostics.restore_status=restored and 'restored' or why
    return S
end

    end)()
    local settings_factory=(function()
-- Build switches through the ACTUAL NewSetting option factory, with its real
-- parent, panel, config, blueprint and constructor argument layout.
return function(opt)
    local U={diagnostics={rows=11,location='native_settings_only',floating_ui=false}}
    local panels=setmetatable({},{__mode='k'})
    local advanced={TitleFeature=true,UniversalSignSwitch=true,bCanIntelligentSign=true,bCloseHitHeadAudio=true}
    local entries={{'master','BAT MOD SKIN'},{'weapons','SKIN SUNG'},{'lobby','SKIN SANH'},
        {'backpack','ANH SUNG TRONG O TRANG BI'}, {'attachments','SKIN PHU KIEN'},
        {'workshop','XUONG SKIN'}, {'vehicles','SKIN XE'},
        {'killfeed','THONG BAO DIET'}, {'crates','HOM XAC'},
        {'cosmetics','TRANG PHUC MU GIAY BA LO'}, {'emotes','HANH DONG'}}
    local rows,captions={},{}
    local installed=false
    local creating,factoryDepth=false,0
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);return ok and v or nil
    end
    local function own(row) local k=member(row,'Key');return type(k)=='string' and k:sub(1,8)=='ManhSkin' end
    local function panel_key(panel)
        if type(opt.panel_key)=='function' then
            local ok,key=pcall(opt.panel_key,panel)
            if ok and type(key)=='string' and key~='' then return key end
        end
        return panel
    end
    local function frame_row(args)
        for i=1,args.n do if type(member(args[i],'Key'))=='string' then return args[i],i end end
    end
    local function load(name) local ok,v=pcall(opt.require,name);return ok and v or nil end
    function U.install()
        if installed then return true end
        local manager=type(opt.manager)=='function' and opt.manager() or nil
        local factory=member(manager,'_ProcessShowUI')
        local alias=load('client.slua.umg.NewSetting.Item.AliasMap')
        local stack=load('client.logic.NewSetting.Stack.Stack_Game_Advanced')
        local loc=opt.localize()
        if type(factory)~='function' or type(alias)~='table' or alias.Switcher==nil or type(loc)~='table' then
            U.diagnostics.status='settings_native_factory_unavailable';return false
        end
        captions[-46012090]='BAT';captions[-46012091]='TAT'
        for i,entry in ipairs(entries) do
            local key=entry[1];local text=-46012000-i
            captions[text]=(i==1 and 'MOD SKIN / ' or '')..entry[2]
            rows[i]={Key='ManhSkin_'..key,UI=alias.Switcher,Text=text,
                SwitcherText={-46012090,-46012091},SwitcherValue={true,false},
                GetFunc=function() return opt.get(key)==true end,
                SetFunc=function(_,value)

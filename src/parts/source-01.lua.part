    end
    function P.clear()
        local parents={}
        for view,state in pairs(views) do
            local parent=state.parent
            if parent and active(view,state) and not parents[parent] then
                parents[parent]=true;P.sync_parent(parent)
                call(parent,'RefreshPage',nil,nil,true)
            end
        end
    end
    return P
end

    end)()
    local refinement_factory=(function()
-- Metadata-only categorisation and equipment-family deduplication. Never loads
-- meshes/textures and never chooses a maximum by the magnitude of an item ID.
return function(opt)
    local R={revision=0,diagnostics={processed=0,family_aliases=0,visual_aliases=0,xsuit_groups=0}}
    local queue,index={},1
    local records,queued,aliases,visual,levels,targets={},{},{},{},{},{}
    local groups,visualGroups,modules={}, {},{}

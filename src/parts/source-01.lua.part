    local animated_factory=(function()
-- Two pooled native scene captures of already loaded LOCAL weapons.
-- No model reload, no gameplay attachment writes, no player camera/FOV changes.
return function(opt)
    local R={diagnostics={created=0,captures=0,bindings=0,limit=2}}
    local pool={}
    local function member(o,k)
        if o==nil then return end
        local ok,v=pcall(function() return o[k] end);if ok then return v end
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function static(name,key,...)

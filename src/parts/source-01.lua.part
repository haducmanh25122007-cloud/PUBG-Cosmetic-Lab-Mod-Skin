-- Uses the item-resource checks and download entry point found in the supplied
-- game's LobbyAvatar Lua. No author server, private endpoint or entitlement RPC.
return function(import_class,require_module)
    local R={download_attempted=false}
    local references={}
    local referenceOrder={}
    local ok,utils=pcall(import_class,'BackpackUtils')
    if not ok then utils=nil end
    local function member(o,k)
        local good,value=pcall(function() return o[k] end)
        if good then return value end
    end
    local function static(name,...)
        local fn=member(utils,name)
        if type(fn)~='function' then return false,'missing_'..name end
        return pcall(fn,...)
    end
    function R.inspect(skin_id)
        local made,define=static('GenerateItemDefineIDByItemTableIDWithRandomInstanceID',skin_id)
        if not made or define==nil then return {check_available=false,status='resource_define_unavailable'} end
        local checked,exists=static('IsBattleItemHandleExist',define,false,false,false)
        if not checked or type(exists)~='boolean' then
            return {check_available=false,status='resource_check_unavailable'}
        end
        return {check_available=true,handle_exists=exists,
            status=exists and 'battle_handle_present' or 'battle_handle_missing'}
    end
    function R.preload_handle(id)
        if references[id] then return true,'class_reference_cached' end
        local made,define=static('GenerateItemDefineIDByItemTableIDWithRandomInstanceID',id)
        if not made or define==nil then return false,'preload_define_unavailable' end
        local got,path=static('GetBattleItemHandlePath',define,false,false)
        if not got or type(path)~='string' or path:sub(1,6)~='/Game/' then
            return false,'preload_handle_path_unavailable'
        end
        local loaded,cls=pcall(import_class,path)
        if not loaded or cls==nil then return false,'preload_handle_class_unavailable' end
        references[id]=cls
        referenceOrder[#referenceOrder+1]=id
        if #referenceOrder>64 then references[table.remove(referenceOrder,1)]=nil end
        return true,'class_reference_cached'
    end
    function R.request_download(skin_id)
        if R.download_attempted then return false,'download_already_requested' end
        R.download_attempted=true
        local a,constants=pcall(require_module,'client.slua.logic.download.puffer_const')
        local b,manager=pcall(require_module,'client.slua.logic.download.puffer.puffer_manager')
        local c,tlog=pcall(require_module,'client.slua.logic.download.report.puffer_tlog')
        local d,switch=pcall(require_module,'client.slua.logic.download.puffer_switch')
        if not (a and b and c and d) then return false,'download_modules_unavailable' end
        if member(switch,'BanAutoDownload') then return false,'game_auto_download_disabled' end
        local download=member(manager,'Download')
        local kind=member(member(constants,'ENUM_DownloadType'),'ODPAK')
        local source=member(member(tlog,'Enum_TLog_From'),'Avatar')
        if type(download)~='function' or kind==nil or source==nil then
            return false,'download_entry_unavailable'
        end
        local called,result=pcall(download,kind,{skin_id},source,nil,{bAutoDownload=true,bFirst=true})
        if not called or result==false then return false,'download_call_failed' end
        return true,'game_download_requested_unverified'
    end
    return R
end


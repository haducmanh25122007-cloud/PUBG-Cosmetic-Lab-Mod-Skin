    local recovery_factory=(function()
-- Observe local appearance/attachment transitions. No game calls or writes.
return function(opt)
    opt=opt or {}
    local states=setmetatable({},{__mode='k'})
    local R={diagnostics={requests=0}}
    function R.observe(weapon,tick,target,current,snapshot,attachments,component)
        local s=states[weapon]
        if not s or s.target~=target then
            s={target=target,attachments=attachments,component=component,attempts=0}
            states[weapon]=s
        end
        local slotsKnown=type(snapshot.slot_skin_id)=='number'
        local slotOK=slotsKnown and snapshot.slot_skin_id==target
        local entityKnown=type(snapshot.entity_skin_id)=='number'
        local entityOK=entityKnown and snapshot.entity_skin_id==target
        local reason
        if not s.stock_asset and type(snapshot.stock_master_asset_key)=='string' then
            s.stock_asset=snapshot.stock_master_asset_key
        end
        if s.confirmed then
            if attachments~=nil and s.attachments~=nil and attachments~=s.attachments then
                reason='weapon_attachments_changed'
            elseif component~=s.component then reason='weapon_component_recreated'
            elseif slotsKnown and not slotOK then reason='weapon_slot_reset'
            elseif entityKnown and not entityOK then reason='weapon_entity_reset'
            elseif s.master_asset_key and type(snapshot.master_asset_key)=='string'
                and snapshot.master_asset_key~=s.master_asset_key
                and (snapshot.master_mesh_default==true or snapshot.master_asset_key==s.stock_asset) then
                reason='weapon_master_mesh_changed'
            elseif s.main_confirmed and current~=target then reason='weapon_main_id_reset'
            elseif s.cache_confirmed and type(snapshot.component_skin_id)=='number'
                and snapshot.component_skin_id~=target then reason='weapon_skin_cache_reset' end
        end
        local confirmed=(slotOK and entityOK and snapshot.mesh_valid and snapshot.all_mesh_loaded==true)
            or (current==target and (not slotsKnown or slotOK) and (not entityKnown or entityOK))
        if not reason then
            if confirmed then
                s.confirmed=true
                if type(snapshot.master_asset_key)=='string' then
                    if s.master_asset_key and s.master_asset_key~=snapshot.master_asset_key then
                        R.diagnostics.accepted_lod_or_form_changes=(R.diagnostics.accepted_lod_or_form_changes or 0)+1
                    end
                    s.master_asset_key=snapshot.master_asset_key
                end
                if current==target then s.main_confirmed=true end
                if snapshot.component_skin_id==target then s.cache_confirmed=true end
                s.good_since=s.good_since or tick
                if tick-s.good_since>=(opt.stable_ticks or 8) then s.attempts=0 end
            else s.good_since=nil end
            s.pending=nil
            if s.attachments==nil then s.attachments=attachments end
            return false
        end
        s.good_since=nil
        local key=reason..':'..(attachments or '')
        if s.pending~=key then s.pending=key;s.pending_since=tick;return false,reason..'_pending' end
        if tick-s.pending_since<(opt.settle_ticks or 2)
            or (s.last_request and tick-s.last_request<(opt.cooldown_ticks or 8)) then return false,reason..'_pending' end
        if s.attempts>=(opt.max_attempts or 3) then
            if reason=='weapon_attachments_changed' and attachments~=s.last_attachments_request then
                s.attempts=0
            else
            R.diagnostics.status='weapon_recovery_limit';return false,'weapon_recovery_limit'
            end
        end
        s.attempts=s.attempts+1;s.last_request=tick
        if reason=='weapon_attachments_changed' then s.last_attachments_request=attachments end
        s.attachments=attachments or s.attachments;s.component=component
        s.pending=nil
        R.diagnostics.requests=R.diagnostics.requests+1
        R.diagnostics.status=reason
        return true,reason
    end
    return R
end


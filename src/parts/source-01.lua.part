    local Weapon=(function()
-- Native names from supplied 4.6 SDK and WeaponAvatarComponent Lua.
-- v0.3 device evidence: apply returns true, but main avatar ID never confirms.
-- Context is {weapon=<LOCAL current weapon>, is_valid=<engine object validator>}.
-- Readback confirms only the native ID, not loaded meshes, animation or replication.
local A={}
local function call(o,name,...)
    local ok,fn=pcall(function() return o[name] end)
    if not ok or type(fn)~='function' then return nil,'missing_'..name end
    local success,a=pcall(fn,o,...)
    if not success then return nil,'failed_'..name end
    return a
end
local function target(ctx,base)
    if type(ctx)~='table' or type(ctx.is_valid)~='function' then return nil,'missing_validator' end
    local w=ctx.weapon
    local ok,valid=pcall(ctx.is_valid,w)
    if not ok or valid~=true then return nil,'weapon_not_ready' end
    local id=call(w,'GetWeaponID')
    if id~=base then return nil,'wrong_base_weapon' end
    local got,c=pcall(function() return w.WeaponAvatarComponent end)
    if not got then return nil,'component_not_ready' end

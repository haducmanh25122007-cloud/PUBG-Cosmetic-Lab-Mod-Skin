    local ui_access_factory=(function()
-- Locate live Lua UI instances through the game's own UIManager registry.
-- These objects are distinct from module/class tables and cached callbacks.
return function(opt)
    local U={diagnostics={}}
    local observed=setmetatable({},{__mode='k'})
    local installed=false
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);if ok then return v end;return nil
    end
    local function manager() return opt.manager() end
    function U.install()
        if installed then return true end
        local m=manager();local factory=member(m,'_ProcessShowUI')
        if type(factory)~='function' then return false end
        m._ProcessShowUI=function(parent,panel,cfg,module,bp,...)
            local result=table.pack(factory(parent,panel,cfg,module,bp,...))
            if result[1]~=nil then
                observed[result[1]]={module=module or member(cfg,'moduleName') or '',
                    key=member(cfg,'keyName') or '',bp=bp or member(cfg,'path') or '',parent=parent,panel=panel}
                if type(opt.observe_ui)=='function' then pcall(opt.observe_ui,result[1],observed[result[1]]) end
            end
            return table.unpack(result,1,result.n)
        end
        installed=true;U.diagnostics.factory_lifecycle_hook=true;return true
    end
    function U.instances()
        U.install()
        local result={};local seen={}
        local function append(view,frame)
            if view~=nil and not seen[view] then result[#result+1]={view=view,frame=frame or {}};seen[view]=true end
        end
        for view,frame in pairs(observed) do append(view,frame) end
        local m=manager();local getter=member(m,'GetUIInstances')
        if type(getter)=='function' then
            local ok,views=pcall(getter)
            if ok and type(views)=='table' then
                for key,view in pairs(views) do append(view,{key=tostring(key)}) end
            end
        end
        return result
    end
    local function get(cfg,key)
        local m=manager();local fn=member(m,'GetUI');local value=member(member(m,cfg),key)
        if type(fn)~='function' or value==nil then return end
        local ok,view=pcall(fn,value);if ok then return view end
    end
    function U.vehicle_collection()
        return get('UI_Config','VehicleSystem_Main_UIBP')
    end
    function U.wardrobe()
        local parent=get('UI_Config','wardrobe')
        local view=member(parent,'curIns')
        U.diagnostics.wardrobe_parent=parent~=nil;U.diagnostics.wardrobe_live_view=view~=nil
        return view,parent
    end
    function U.workshop()
        local view=get('UI_Config','item_upgrade')
        U.diagnostics.workshop_live_view=view~=nil;return view
    end
    function U.backpack_views()
        local m=manager();local getter=member(m,'GetUI');local result={}
        if type(getter)~='function' then U.diagnostics.status='ui_manager_getter_unavailable';return result end
        local keys={};local seen={}
        for _,scope in ipairs({'UI_Config_InGame','UI_Config'}) do
            local cfg=member(m,scope)
            if type(cfg)=='table' then
                local key,value=next(cfg);local count=0
                while key~=nil and count<4096 do
                    count=count+1
                    if type(key)=='string' and key:lower():gsub('_',''):find('backpack',1,true) then
                        keys[#keys+1]=key
                        local ok,view=pcall(getter,value)
                        if ok and view~=nil and not seen[view] then result[#result+1]=view;seen[view]=true end
                    end
                    key,value=next(cfg,key)
                end
            end
        end
        for _,entry in ipairs(U.instances()) do
            local path=(entry.frame.module or ''):lower();local key=(entry.frame.key or ''):lower()
            if (path:find('backpack',1,true) or key:find('backpack',1,true)) and not seen[entry.view] then
                result[#result+1]=entry.view;seen[entry.view]=true
            end
        end
        U.diagnostics.backpack_config_keys=keys;U.diagnostics.backpack_live_views=#result
        return result
    end
    return U
end


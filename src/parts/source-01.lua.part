                end
            end
        end
        C.diagnostics.xsuit_native_state_hook=true
    end
    function C.start()
        C.load_xsuits()
        if source or C.diagnostics.status=='complete' then return true end
        local ok,ids=static(opt.import('BackpackUtils'),'GetItemIDs')
        local n=ok and size(ids)
        if not n or n<=0 then
            local got,t=static(opt.import('BusinessHelper'),'GetDataTable','Item')
            if got and t then
                for _,withOut in ipairs({false,true}) do
                    local results
                    if withOut then results=table.pack(static(opt.import('DataTableFunctionLibrary'),'GetDataTableRowNames',t,nil))
                    else results=table.pack(static(opt.import('DataTableFunctionLibrary'),'GetDataTableRowNames',t)) end
                    if results[1] then
                        for i=2,results.n do
                            local s=size(results[i]);if type(s)=='number' and s>0 then ids=results[i];n=s;break end
                        end
                    end
                    if n and n>0 then break end
                end
            end
        end
        if type(n)~='number' or n<1 or n>150000 or n%1~=0 then
            if #priority==0 then C.diagnostics.status='cosmetic_item_enumeration_unavailable';return false end
            ids={};n=0;C.diagnostics.native_item_ids_unavailable=true
        end
        source=ids;count=n;C.diagnostics.total_ids=n;C.diagnostics.status='reading';return true
    end
    function C.step()
        if type(opt.in_lobby)=='function' and not opt.in_lobby() and options.live_scan_in_match==false then return end
        if refinement then
            local before=refinement.revision
            refinement.step()
            for _,id in ipairs(refinement.take_targets()) do native_row(id) end
            C.diagnostics.refinement=refinement.diagnostics
            if before~=refinement.revision then revision=revision+1 end
            if refinement.diagnostics.complete and C.diagnostics.status=='complete'
                and C.refinement_completed~=refinement.revision then
                C.refinement_completed=refinement.revision;catalogue_generation=catalogue_generation+1
            end
        end
        if type(opt.in_lobby)=='function' and not opt.in_lobby() and options.live_scan_in_match==false then return end
        if not C.diagnostics.xsuit_groups then C.load_xsuits() end
        C.step_levels()
        if not source or (index>=count and priority_index>#priority) then return end
        local batch=type(opt.in_lobby)=='function' and opt.in_lobby() and (options.scan_batch or 256) or 48
        local clock=opt.clock
        local begin=type(clock)=='function' and clock() or nil
        local budget=options.scan_budget_seconds or 0.002
        for _=1,batch do
            if index>=count and priority_index>#priority then break end
            local raw
            if priority_index<=#priority then
                raw=priority[priority_index];priority_index=priority_index+1
                C.diagnostics.avatar_candidates_scanned=priority_index-1
            else raw=at(source,index);index=index+1 end
            if type(raw)~='string' and type(raw)~='number' then
                local ok,text=static(opt.import('KismetStringLibrary'),'Conv_NameToString',raw);if ok then raw=text end
            end
            local id=tonumber(raw)
            if id and id>0 and id<=2147483647 and id%1==0 and not byID[id] then
                local kind,slot,cfg=C.classify(id)
                if kind and C.normalize(id)==id then
                    local metadata=type(opt.avatar)=='function' and opt.avatar(id)
                    local row={id=id,kind=kind,slot=slot,name=member(cfg,'ItemName'),
                        itemType=member(cfg,'ItemType'),itemSubType=member(cfg,'ItemSubType'),
                        icon_path=member(cfg,'ItemBigIcon') or member(cfg,'ItemSmallIcon'),
                        quality=member(cfg,'ItemQuality') or member(cfg,'Quality')}
                    if metadata and (row.name==nil or row.name=='') then row.name=metadata.name end
                    if insert(row) and metadata then
                        C.diagnostics.avatar_discovered=C.diagnostics.avatar_discovered+1
                    end
                elseif not kind and type(opt.avatar)=='function' and opt.avatar(id) then
                    C.diagnostics.avatar_item_rows_missing=(C.diagnostics.avatar_item_rows_missing or 0)+1
                end
            end
            if priority_index>#priority and not C.diagnostics.priority_complete then
                C.diagnostics.priority_complete=true;catalogue_generation=catalogue_generation+1
            end
            if begin and clock()-begin>=budget then break end
        end
        C.diagnostics.scanned=index
        if index>=count and priority_index>#priority then
            C.diagnostics.status='complete';table.sort(ordered,function(a,b) return a.id<b.id end)
            catalogue_generation=catalogue_generation+1
        end
    end
    function C.invalidate() catalogue_generation=catalogue_generation+1;revision=revision+1 end
    function C.refresh_view(view,parent)
        if parent==nil or refreshing or catalogue_generation==0
            or refreshed[parent]==catalogue_generation then return false end
        if type(member(parent,'RefreshPage'))~='function' then
            C.diagnostics.refresh_status='native_wardrobe_refresh_unexposed';return false
        end
        -- RefreshPage is the real wardrobe parent API: preserve the subtab.
        -- Mark before calling because it closes/recreates curIns synchronously.
        refreshed[parent]=catalogue_generation;refreshing=true
        local ok,result=call(parent,'RefreshPage',nil,nil,true)
        refreshing=false
        if not ok or result==false then
            C.diagnostics.refresh_status='native_wardrobe_refresh_failed';return false
        end
        C.diagnostics.native_refreshes=(C.diagnostics.native_refreshes or 0)+1
        C.diagnostics.refresh_status='native_wardrobe_refresh_requested_unverified'
        return true
    end
    function C.rows(kind,slot)
        local result={}
        for _,r in ipairs(ordered) do
            if visible(r) and r.kind==kind and (slot==nil or slot==r.slot) then
                local row={id=r.id,name=r.name,slot=r.slot,level=C.level(r.id),icon_path=r.icon_path}
                row.selected=opt.selected(kind,r.slot)==r.id
                result[#result+1]=row
            end
        end
        return result
    end
    local function context()
        local ok,avatar,emote=pcall(opt.context)
        if ok then return avatar,emote end
    end
    function C.sync()
        if not opt.enabled('cosmetic') then return false end
        if type(opt.ready)=='function' and not opt.ready() then
            C.diagnostics.apply_status='waiting_for_weapon_assets';return false
        end
        local avatar=context();if not opt.valid(avatar) then return false end
        local state=applied[avatar]
        if not state then state={};applied[avatar]=state end
        local changed=false
        for slot,id in pairs(opt.selections('cosmetic')) do
            local normalized=C.normalize(id)
            if normalized~=id then
                opt.choose('cosmetic',slot,normalized);id=normalized;revision=revision+1
                if presentation then presentation.changed('cosmetic',slot) end
            end
            local kind,actual=C.classify(id)
            if kind=='cosmetic' and actual==slot and visible(byID[id] or {}) then
                local got,define=call(avatar,'GetEquippedItemDefineID',slot)
                local current=got and member(define,'TypeSpecificID')
                local s=state[slot]
                if current~=id and (not s or s.target~=id or
                    (opt.tick()-s.tick>=30 and s.tries<3)) then
                    if not s then s={original=current,tries=0};state[slot]=s end
                    if s.target~=id then s.tries=0 end
                    s.target=id;s.tick=opt.tick();s.tries=s.tries+1
                    local ok,item=static(opt.import('BackpackUtils'),'GetItemDefineIDByItemID',id)
                    local ctor=opt.import('AvatarCustom');local made,custom=pcall(function() return ctor() end)
                    if ok and item and made then
                        local good,result=call(avatar,'HandleEquipItem',item,custom)
                        if good and result~=false then
                            changed=true;C.diagnostics.apply_requests=C.diagnostics.apply_requests+1
                            local level=C.level(id)
                            print('[Lua-Mod] Applied SlotType '..slot..' -> AvatarID '..id..
                                (level and (' (Max Level '..level..')') or ' (tier metadata unavailable)'))
                        end
                    end
                end
            end
        end
        C.diagnostics.status=changed and 'cosmetic_local_apply_requested_visual_unverified' or C.diagnostics.status
        return changed
    end
    function C.play(id)
        local kind=C.classify(id)
        if not opt.enabled('emote') or kind~='emote' then return false,'emote_not_available' end
        local _,emote=context()
        if not opt.valid(emote) then return false,'local_emote_component_unavailable' end
        local ok,result=call(emote,'LocalStartPlayEmote',id,0,false,'')
        if ok and result~=false then C.current_emote={component=emote,id=id} end
        C.diagnostics.emote_status=ok and result~=false and 'local_emote_requested_unverified' or 'local_emote_request_failed'
        return ok and result~=false,C.diagnostics.emote_status
    end
    function C.stop_emote()
        local current=C.current_emote
        if current and opt.valid(current.component) then call(current.component,'LocalInteruptPlayEmote',current.id) end
        C.current_emote=nil
    end
    function C.select(id)
        id=C.normalize(id)
        local kind,slot=C.classify(id)
        if not kind or not opt.enabled(kind) then return false,'cosmetic_toggle_off_or_invalid_id' end
        if byID[id] and not visible(byID[id]) then return false,'unnamed_or_lower_tier_catalogue_row' end
        if not opt.choose(kind,slot,id) then return false,'cosmetic_selection_failed' end
        revision=revision+1
        if presentation then presentation.changed(kind,slot) end
        if kind=='emote' then return C.play(id) end
        C.sync();return true,'cosmetic_local_selection_saved'
    end
    function C.bind_view(view,parent)
        if presentation then presentation.bind(view,parent) end
        local tabs=member(parent,'subTabMap')
        if type(tabs)=='table' then
            for _,entry in pairs(tabs) do remember_tab(member(entry,'tabConfig'),'wardrobe_parent.tabConfig.ItemSubTypeIDs') end
        end
        remember_tab(member(view,'subTabConfig'),'wardrobe_view.subTabConfig.ItemSubTypeIDs')
        if type(view)=='table' then
            local ok,source=call(view,'GetDataSource')
            C.diagnostics.view_source=ok and tostring(source) or 'unexposed'
            local origin=member(view,'OriginItemList')
            if type(origin)=='table' and C.observed_origin~=origin then
                C.observed_origin=origin;C.diagnostics.view_origin_rows=count_rows(origin)
            end
            local grid=member(view,'LoopScrollGrid_Avatar')
            local counted,n=call(grid,'GetItemCount')
            if counted and type(n)=='number' then C.diagnostics.avatar_grid_rows=n end
        end
        if type(view)~='table' or boundViews[view] then return false end
        local function local_row(row)
            local id=member(row,'res_id') or member(row,'resID') or member(row,'ResID')
            local ins=member(row,'ins_id') or member(row,'insID') or member(row,'InsID')
            local r=id and byID[id]
            if r and (ins==-id or member(row,'__manhduathoi_cosmetic')) then return r end
        end
        local function choose(self,row)
            local r=local_row(row);if not r then return false end
            if opt.enabled(r.kind) then
                C.select(r.id)
                row.isUsing=opt.selected(r.kind,r.slot)==r.id
                row.isSelected=row.isUsing
            end
            return true
        end
        local click=member(view,'ClickItem')
        if type(click)=='function' then
            view.ClickItem=function(self,row,...)
                if choose(self,row) then return end
                return click(self,row,...)
            end
        end
        local onClick=member(view,'OnClickItem')
        if type(onClick)=='function' then
            view.OnClickItem=function(self,widget,index,...)
                local ok,row=call(self,'GetItemData',index)
                if ok and choose(self,row) then return end
                for key,grid in next,self do
                    if type(key)=='string' and key:find('LoopScroll',1,true) then
                        local got,data=call(grid,'GetItemData',index)
                        if got and choose(self,data) then return end
                    end
                end
                return onClick(self,widget,index,...)
            end
            for key,grid in next,view do
                if type(key)=='string' and key:find('LoopScroll',1,true) then
                    call(grid,'SetClickItemCallback',view.OnClickItem,view)
                end
            end
        end
        if type(click)~='function' and type(onClick)~='function' then return false end
        boundViews[view]=true
        C.diagnostics.native_view_bindings=(C.diagnostics.native_view_bindings or 0)+1
        return true
    end
    local proxies=setmetatable({},{__mode='k'})
    function C.overlay(original)
        if type(original)~='table' then return original end
        local flags=tostring(opt.enabled('cosmetic'))..':'..tostring(opt.enabled('emote'))
        local projected=projections[original]
        if projected then
            if projected.revision==revision and projected.flags==flags then
                C.diagnostics.overlay_cache_hits=(C.diagnostics.overlay_cache_hits or 0)+1;return original
            end
            original=projected.base
        end
        local cached=overlay_cache[original]
        if cached and cached.revision==revision and cached.flags==flags then
            C.diagnostics.overlay_cache_hits=(C.diagnostics.overlay_cache_hits or 0)+1;return cached.data
        end
        local result,seen={},{}
        local array=rawlen(original)>0
        local function keep(key,row)
            local id=member(row,'resID') or member(row,'res_id')
            local r=id and byID[id]
            if id and opt.enabled('cosmetic') and C.normalize(id)~=id then return end
            if not r or not opt.enabled(r.kind) or visible(r) then
                if array then result[#result+1]=row else result[key]=row end
                if id then seen[id]=true end
            end
        end
        if array then for key,row in ipairs(original) do keep(key,row) end
        else for key,row in next,original do keep(key,row) end end
        local function add(row)
            local id=member(row,'resID') or member(row,'res_id')
            if id and not seen[id] then
                if array then result[#result+1]=row else result[member(row,'insID') or -id]=row end
                seen[id]=true
            end
        end
        for _,r in ipairs(ordered) do if visible(r) and opt.enabled(r.kind) then add(record(r.id)) end end
        if type(opt.extra_records)=='function' then
            local ok,extra=pcall(opt.extra_records)
            if ok and type(extra)=='table' then for _,row in ipairs(extra) do add(row) end end
        end
        overlay_cache[original]={revision=revision,flags=flags,data=result}
        projections[result]={revision=revision,flags=flags,base=original,count=count_rows(result)}
        C.diagnostics.overlay_builds=(C.diagnostics.overlay_builds or 0)+1
        return result
    end
    function C.bind_data_entity()
        if C.diagnostics.data_entity_hook then return end
        local got,center=pcall(opt.require,'client.slua.logic.wardrobe.logic_wardrobe_data_center')
        local original=got and member(center,'GetWardrobeData')
        if type(original)~='function' then return end
        source_identity_check=function(source,entity)
            local ok,localEntity=pcall(original)
            local got,value=true,entity
            if value==nil then got,value=pcall(original,source) end
            local localSource=ok and got and localEntity~=nil and localEntity==value
            if localSource and (type(source)=='number' or type(source)=='string') then normal_source_cached=source end
            return localSource
        end
        center.GetWardrobeData=function(source,...)
            local entity=original(source,...)
            source_query(source)
            C.diagnostics.entity_type=type(entity)
            if not C.source_is_normal(source,entity) or type(entity)~='table' then return entity end
            C.diagnostics.entity_projection_calls=(C.diagnostics.entity_projection_calls or 0)+1
            if proxies[entity] then return proxies[entity] end
            local proxy={}
            local snapshot
            local function indexed_data()
                local stamp=revision..':'..tostring(opt.enabled('cosmetic'))..':'..tostring(opt.enabled('emote'))
                local ok,native=call(entity,'GetData')
                if snapshot and snapshot.stamp==stamp and snapshot.native==native then return snapshot end
                local data=ok and C.overlay(native) or {}
                if type(data)~='table' then data={} end
                snapshot={stamp=stamp,native=native,data=data,counts={},byRes={},byType={}}
                C.diagnostics.entity_index_builds=(C.diagnostics.entity_index_builds or 0)+1
                for key,row in pairs(data) do
                    local id,kind,count=member(row,'resID'),member(row,'itemType'),member(row,'count') or 0
                    if id then
                        snapshot.counts[id]=(snapshot.counts[id] or 0)+count
                        snapshot.byRes[id]=snapshot.byRes[id] or {};snapshot.byRes[id][key]=row
                    end
                    if kind then snapshot.byType[kind]=(snapshot.byType[kind] or 0)+count end
                end
                return snapshot
            end
            local function raw_data() return indexed_data().data end
            function proxy:GetData() return raw_data() end
            for _,name in ipairs({'GetDataByInsID','GetDataByResID','GetDataByResIDAndTimeliness'}) do
                proxy[name]=function(_,id,...)
                    local row=byID[math.abs(tonumber(id) or 0)]
                    if row and opt.enabled(row.kind) and visible(row) then return record(row.id) end
                    if row and opt.enabled(row.kind) and not visible(row) then return nil end
                    if type(id)=='number' and maxSuit[id] and maxSuit[id]~=id and opt.enabled('cosmetic') then return nil end
                    local ok,result=call(entity,name,id,...);if ok then return result end
                end
            end
            function proxy:GetDataListByResID(id,...)
                local result={}
                for key,row in pairs(indexed_data().byRes[id] or {}) do result[key]=row end
                return result
            end
            function proxy:GetItemCountByResID(id,...)
                return indexed_data().counts[id] or 0
            end
            function proxy:GetItemCountByItemType(kind,...)
                return indexed_data().byType[kind] or 0
            end
            function proxy:GetItemCountListByItemType(kind,...)
                local ok,native=call(entity,'GetItemCountListByItemType',kind,...)
                local result={};if ok and type(native)=='table' then for k,v in pairs(native) do result[k]=v end end
                if opt.enabled('cosmetic') then
                    for key,v in pairs(result) do
                        local id=type(v)=='table' and member(v,'ResID') or tonumber(key)
                        if id and C.normalize(id)~=id then result[key]=nil end
                    end
                end
                local tableShape=false
                for _,v in pairs(result) do if type(v)=='table' then tableShape=true;break end end
                for _,row in pairs(raw_data()) do
                    if member(row,'itemType')==kind then
                        if tableShape then result[row.insID]={InsID=row.insID,ResID=row.resID,Count=row.count}
                        else result[row.resID]=row.count end
                    end
                end
                return result
            end
            for _,name in ipairs({'InitData','AddData','ChangeData','RemoveData','ChangeItemNewState'}) do
                local write=member(entity,name)
                if type(write)=='function' then
                    proxy[name]=function(_,...)
                        snapshot=nil;revision=revision+1
                        return write(entity,...)
                    end
                end
            end
            setmetatable(proxy,{__index=function(_,key)
                local value=member(entity,key)
                if type(value)=='function' then return function(_,...) return value(entity,...) end end
                return value
            end,__newindex=function(_,key,value) entity[key]=value end})
            proxies[entity]=proxy;return proxy
        end
        C.diagnostics.data_entity_hook=true
    end
    function C.install()
        C.bind_data_entity()
        if C.diagnostics.depot_hook then return true end
        local ok,depot=pcall(opt.require,'client.slua.logic.wardrobe.wardrobe_data')
        if not ok or type(depot)~='table' then return false end
        for _,key in ipairs({'GetHallDepotItemDataByInsID','GetValidHallDepotItemDataByInsID',
            'GetHallDepotItemDataByResID','GetHallDepotItemDataByResIDAndTimeliness',
            'GetHallDepotItemDataByResIDAndValidExpireTime'}) do
            local original=member(depot,key)
            if type(original)=='function' then
                depot[key]=function(self,id,...)
                    local row=byID[math.abs(tonumber(id) or 0)]
                    local first,second=...
                    local source=first
                    if key=='GetHallDepotItemDataByResIDAndTimeliness' then source=second end
                    if row and opt.enabled(row.kind) and C.source_is_normal(source) then
                        return visible(row) and record(row.id) or nil
                    end
                    return original(self,id,...)
                end
            end
        end
        local array=member(depot,'GetArrayHallDepotItemInfo')
        if type(array)=='function' then
            depot.GetArrayHallDepotItemInfo=function(self,...)
                local original=array(self,...)
                local source=select(1,...)
                C.diagnostics.array_calls=(C.diagnostics.array_calls or 0)+1
                C.diagnostics.array_source=tostring(source)
                C.diagnostics.array_original_type=type(original)
                if not C.source_is_normal(source) or type(original)~='table' then return original end
                local projected=C.overlay(original)
                C.diagnostics.array_projected_calls=(C.diagnostics.array_projected_calls or 0)+1
                C.diagnostics.array_rows_before=count_rows(original)
                C.diagnostics.array_rows_after=count_rows(projected)
                return projected
            end
        end
        local got,logic=pcall(opt.require,'client.slua.logic.wardrobe.logic_wardrobe_new')
        for _,key in ipairs({'IsCanUse','GetWardrobeInsIdByResId'}) do
            local original=got and member(logic,key)
            if type(original)=='function' then
                logic[key]=function(self,id,...)
                    local row=byID[C.normalize(id)]
                    if row and opt.enabled(row.kind) then return key=='IsCanUse' and true or -row.id end
                    return original(self,id,...)
                end
            end
        end
        local converter=got and member(logic,'ArrayHallDepotToCommonItem')
        if presentation and type(converter)=='function' then
            logic.ArrayHallDepotToCommonItem=function(self,...)
                local result=table.pack(converter(self,...))
                presentation.track(result[1]);return table.unpack(result,1,result.n)
            end
        end
        local pageFilter=got and member(logic,'IsValidCurrentPageItem')
        if type(pageFilter)=='function' then
            logic.IsValidCurrentPageItem=function(self,page,tab,row,...)
                local id=member(row,'resID') or member(row,'res_id')
                local ins=tonumber(member(row,'insID') or member(row,'ins_id'))
                if id and byID[id] and ins==-id then
                    local d=C.diagnostics.local_page_filter or {tested=0,accepted=0,rejected=0,native_fallbacks=0,reasons={}}
                    C.diagnostics.local_page_filter=d
                    local accepted,reason=C.local_page_item(self,page,tab,row)
                    d.tested=d.tested+1;d.last_page=tostring(page);d.last_tab=tostring(tab)
                    d.reasons[reason]=(d.reasons[reason] or 0)+1
                    if accepted~=nil then
                        local key=accepted and 'accepted' or 'rejected';d[key]=d[key]+1
                        if accepted then
                            local samples=d.accepted_samples or {};d.accepted_samples=samples
                            if #samples<6 then samples[#samples+1]={id=id,page=page,tab=tab,item_sub_type=member(row,'itemSubType')} end
                        end
                        return accepted
                    end
                    -- An unexposed configuration is not permission to put all
                    -- cosmetics in this tab. Preserve the native answer.
                    d.native_fallbacks=d.native_fallbacks+1
                end
                local result=table.pack(pageFilter(self,page,tab,row,...))
                if id and byID[id] and (ins==-id or member(row,'__manhduathoi_cosmetic')) then
                    local d=C.diagnostics.native_page_filter or {tested=0,accepted=0,rejected=0}
                    C.diagnostics.native_page_filter=d;d.tested=d.tested+1
                    local key=result[1] and 'accepted' or 'rejected';d[key]=d[key]+1
                    d.last_page=tostring(page);d.last_tab=tostring(tab)
                    if not result[1] then
                        local samples=d.rejected_samples or {};d.rejected_samples=samples
                        if #samples<6 then samples[#samples+1]={id=id,item_type=member(row,'itemType'),
                            item_sub_type=member(row,'itemSubType'),source=member(row,'source')} end
                    end
                end
                return table.unpack(result,1,result.n)
            end
        end
        local put=got and member(logic,'wardrobe_puton_req')
        if type(put)=='function' then
            logic.wardrobe_puton_req=function(self,ins,...)
                local row=type(ins)=='number' and ins<0 and byID[-ins]
                if row then
                    if opt.enabled(row.kind) then return C.select(-ins) end
                    return false,'cosmetic_toggle_off'
                end
                return put(self,ins,...)
            end
        end
        C.diagnostics.depot_hook=true;return true
    end
    function C.clear()
        C.stop_emote()
        if presentation then presentation.clear() end
        for avatar,state in pairs(applied) do
            if opt.valid(avatar) then
                for slot,s in pairs(state) do

    local projection_factory=(function()
-- SDK Gameplay.UAEPlayerController local (non-replicated) avatar maps.
-- No writes to Initial* replicated lists and no entitlement/RPC requests.
return function(opt)
    local P={diagnostics={weapon_map_writes=0,vehicle_list_writes=0}}
    local saved=setmetatable({},{__mode='k'})
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);return ok and v or nil
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function get(map,key)
        local ok,value=call(map,'Get',key)
        if ok then return value end
        local got,value=pcall(function()
            for k,v in pairs(map) do if k==key then return v end end
        end)
        if got then return value end
    end
    local function put(map,key,value)
        local ok,result=call(map,'Add',key,value)
        if not ok or result==false then return false end
        return get(map,key)~=nil

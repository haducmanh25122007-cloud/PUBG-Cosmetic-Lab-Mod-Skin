                        best,level,family,groupID=upgrade_family(id)
                        if not best and root~=id then best,level,family,groupID=upgrade_family(root) end
                    end
                    if best then
                        for _,memberId in ipairs(family) do byId[memberId]=best end
                        byId[id]=best
                        local key='upgrade:'..best
                        if not groups[key] then upgrades=upgrades+1 end
                        groups[key]={id=best,cfg=item(best),level=level,group_id=groupID,base=opt.base,members=family}

    for _,row in ipairs(opt.rows) do
        catalog[row.base]=catalog[row.base] or {};catalog[row.base][#catalog[row.base]+1]=row
        baseBySkin[row.id]=row.base
    end
    local filterReady=type(opt.filter)~='function'
    local lastFilter=-100

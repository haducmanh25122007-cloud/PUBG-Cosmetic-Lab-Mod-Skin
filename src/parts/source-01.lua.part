        note(kind..'_load_result',success and 'success' or 'failed')
        note(kind..'_load_reason',why)
        local label=kind=='wardrobe' and 'Tu do' or 'Ba lo'
        local english=kind=='wardrobe' and 'Wardrobe' or 'Backpack'
        notice_once(kind..(success and '_success' or '_failed'),
            english..(success and ' data OK | ' or ' failed | ')..

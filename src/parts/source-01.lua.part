                local row={};for k,v in pairs(r) do row[k]=v end
                row.resId=entry.id;row.resID=entry.id;row.res_id=entry.id;row.ins_id=-entry.id
                row.isUsing=opt.selected(current)==entry.id;row.isSelected=false;row.hasLock=false

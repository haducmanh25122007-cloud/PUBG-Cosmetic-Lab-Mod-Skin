    local collection_factory=(function()
-- Local VehicleCollectSystem UI projection; account rewards stay unchanged.
return function(opt)
    local C={diagnostics={local_ui_only=true,counts={}}}
    local installed=setmetatable({},{__mode='k'})
    local bound=setmetatable({},{__mode='k'})
    local hidden=setmetatable({},{__mode='k'})
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);return ok and v or nil
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    function C.install()
        local module=opt.module()
        if module==nil then C.diagnostics.status='vehicle_collect_module_unavailable';return false end
        if installed[module] then return true end
        local own=member(module,'GetOwnVehicleNumByType')
        local sum=member(module,'GetSumVehicleNumByType')
        if type(own)~='function' or type(sum)~='function' then return false end
        module.GetOwnVehicleNumByType=function(self,kind,...)
            if opt.enabled() then
                local ok,n=pcall(sum,self,kind)
                if ok and type(n)=='number' and n>=0 and n<=2048 then
                    C.diagnostics.counts[tostring(kind)]={owned=n,total=n}
                    return n
                end
            end
            return own(self,kind,...)
        end
        installed[module]=true;C.diagnostics.count_getter_hook=true
        C.diagnostics.status='vehicle_collection_ui_projection_installed'
        return true
    end
    local function collapse(root)
        local queue={root};local seen={};local count=0
        local function add(value) if value~=nil and not seen[value] then queue[#queue+1]=value end end
        local n=1
        while n<=#queue and n<=2048 do
            local widget=queue[n];n=n+1
            if not seen[widget] then
                seen[widget]=true
                local ok,name=pcall(opt.name,widget)
                local key=ok and type(name)=='string' and name:lower() or ''
                local lock=key:match('^lock') or key:find('_lock',1,true)
                    or (type(name)=='string' and name:find('Lock',1,true))
                if lock and not key:find('unlock',1,true) and not key:find('button',1,true) then
                    local got,state=call(widget,'GetVisibility')
                    if got and type(state)=='number' and state~=1 then
                        hidden[widget]=hidden[widget] or state
                        if call(widget,'SetVisibility',1) then count=count+1 end
                    end
                end
                local got,size=call(widget,'GetChildrenCount')
                if got and type(size)=='number' and size<=512 then
                    for i=0,size-1 do local read,child=call(widget,'GetChildAt',i);if read then add(child) end end
                end
                local tree=member(widget,'WidgetTree');add(member(tree,'RootWidget'))
                local list=member(tree,'AllWidgets');local got,size=call(list,'Num')
                if got and type(size)=='number' and size<=1024 then
                    for i=0,size-1 do local read,child=call(list,'Get',i);if read then add(child) end end
                elseif type(list)=='table' then for _,child in ipairs(list) do add(child) end end
            end

    local vehicle_catalog_factory=(function()
-- Native ItemQuality: purple=5, pink=6, red=7, golden=8.
-- MultiLevelItem is the vehicle-level table; Weapon ItemUpgrade is unrelated.
return function(opt)
    local F={diagnostics={}}
    local function field(o,k) local ok,v=pcall(function() return o[k] end);return ok and v or nil end
    function F.filter(input)
        local rows,eligible={},{}
        local discarded={low_quality=0,unknown_metadata=0,lower_level=0,not_premium=0,not_vehicle=0}
        local maximum={}
        for _,entry in ipairs(input) do
            local cfg=opt.item(entry.id)
            local quality=tonumber(field(cfg,'ItemQuality'))
            local multi=cfg and quality and quality>5 and opt.multi(entry.id) or nil
            local group,level=tonumber(field(multi,'GroupID')),tonumber(field(multi,'Level'))
            local keep=false
            if entry.base<1900000 then discarded.not_vehicle=discarded.not_vehicle+1
            elseif not cfg or not quality then discarded.unknown_metadata=discarded.unknown_metadata+1
            elseif quality<=5 then discarded.low_quality=discarded.low_quality+1
            elseif group and group>0 and level and level>0 then
                if maximum[group]==nil then
                    local list=opt.group(group)
                    local top=0
                    if type(list)=='table' then
                        for _,r in pairs(list) do top=math.max(top,tonumber(field(r,'Level')) or 0) end
                    end
                    maximum[group]=top
                end
                if maximum[group]>0 and level==maximum[group] then keep=true
                elseif maximum[group]==0 then discarded.unknown_metadata=discarded.unknown_metadata+1
                else discarded.lower_level=discarded.lower_level+1 end
            elseif entry.crossover==true then keep=true
            else discarded.not_premium=discarded.not_premium+1 end
            if keep and not eligible[entry.id] then rows[#rows+1]=entry;eligible[entry.id]=true end
        end
        F.diagnostics.rows=#rows;F.diagnostics.discarded=discarded
        F.diagnostics.status=#rows>0 and 'premium_max_catalogue_ready' or 'premium_metadata_not_ready'
        return rows,eligible
    end

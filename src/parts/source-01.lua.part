    local parts_factory=(function()
-- Cosmetic overrides for real attachments already equipped on a local gun.
-- Never adds inventory items, changes stats or equips gameplay attachments.
return function(opt)
    local A={diagnostics={override_requests=0,full_weapon_reloads_avoided=0}}
    local states=setmetatable({},{__mode='k'})
    local groups={}
    local warming={}
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);if ok then return v end;return nil
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function id(value)
        return type(value)=='number' and value>0 and value<=2147483647 and value%1==0
    end
    local function parts_for(skin)
        if groups[skin] then return groups[skin] end
        local g=opt.group(skin)
        if not g or not id(g.group_id) or not id(g.level) then return nil,'attachment_group_unavailable' end
        local mgr=opt.upgrade_manager()
        local got,dic=call(mgr,'GetPartsDic',g.group_id,g.level)
        if not got or type(dic)~='table' then return nil,'attachment_catalogue_unavailable' end
        local byParent,all={},{}
        local visited=0
        for _,list in pairs(dic) do
            if type(list)=='table' then
                for _,part in ipairs(list) do
                    visited=visited+1;if visited>128 then return nil,'attachment_catalogue_too_large' end
                    local matched,value=call(mgr,'GetLevelMatchedPartId',part,g.group_id,g.level)
                    if matched and id(value) then part=value end
                    if id(part) then
                        local ok,parent=pcall(opt.parent,part)
                        if ok and id(parent) then
                            -- Distinct appearances for one parent are ambiguous.
                            if byParent[parent] and byParent[parent]~=part then byParent[parent]=false
                            elseif byParent[parent]==nil then byParent[parent]=part end
                            all[#all+1]=part
                        end
                    end
                end
            end
        end
        -- The native default-skin map is specific to this exact appearance.
        -- Prefer its values over a group list containing alternate forms.
        if type(opt.defaults)=='function' then
            local got,map=pcall(opt.defaults,skin)
            if got and map~=nil then
                local scanned=0
                local read=pcall(function()
                    for _,part in pairs(map) do
                        scanned=scanned+1;if scanned>64 then break end
                        if id(part) then
                            local checked,parent=pcall(opt.parent,part)
                            if checked and id(parent) then byParent[parent]=part;all[#all+1]=part end
                        end
                    end
                end)
                A.diagnostics.default_map_read_ok=read;A.diagnostics.default_map_entries=scanned
            end

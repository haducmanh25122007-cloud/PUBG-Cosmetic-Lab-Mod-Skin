    local workshop_factory=(function()
-- Local upgrade-workshop preview using the supplied item_upgrade Lua class.
-- UI shadow rows do not upgrade an account or spend/request materials.
return function(opt)
    local W={diagnostics={preview_only=true,account_upgrade_written=false}}
    local known={}
    local active
    local bound=setmetatable({},{__mode='k'})
    local snapshots=setmetatable({},{__mode='k'})
    local function copy(row)
        local result={}
        if type(row)=='table' then
            local key,value=next(row);local n=0
            while key~=nil and n<256 do result[key]=value;n=n+1;key,value=next(row,key) end
        end
        for _,key in ipairs({'ID','GroupID','ItemID','Level'}) do
            if result[key]==nil then local ok,value=pcall(function() return row[key] end);if ok then result[key]=value end end
        end
        return result
    end
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);if ok then return v end;return nil
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function group_for_cfg(cfg)
        local group=tonumber(member(cfg,'GroupID'))
        local groups=opt.groups()
        return groups and groups[group]
    end
    local function selected(self)
        local ok,row=call(self,'GetSelectWeaponItemData')

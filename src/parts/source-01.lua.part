-- Experimental ScriptHelperClient storage adapter, based on supplied SDK.
-- Writes only this project's state file. Not yet tested in this game's iOS Lua.
return function(import_class)
    local ok,helper=pcall(import_class,'ScriptHelperClient')
    if not ok or not helper then return nil,'missing_ScriptHelperClient' end
    local function call(name,...)
        local found,fn=pcall(function() return helper[name] end)
        if not found or type(fn)~='function' then return nil,'missing_'..name end
        local success,value=pcall(fn,...)
        if not success then return nil,'failed_'..name end
        return value
    end
    local dir,err=call('GetPureIOSDocumentsDirectory')
    if type(dir)~='string' or dir:sub(1,1)~='/' then return nil,err or 'invalid_documents_path' end
    local path=dir:gsub('/+$','')..'/ManhDuathoi-M416-Trial-v1.state'
    local diagnostics={write_attempted=false,readback_verified=false}
    local function read()
        local text,why=call('LoadFileToStringByFullPath',path)
        diagnostics.read_type=type(text)
        diagnostics.read_length=type(text)=='string' and #text or -1
        diagnostics.read_error=why
        -- Only this trial's own tiny state file; hex preserves BOM/newline/NUL evidence.
        diagnostics.read_prefix_hex=type(text)=='string' and text:sub(1,64):gsub('.',function(c)
            return string.format('%02x',c:byte())
        end) or ''
        if type(text)~='string' or text=='' then return nil,why or 'state_missing_or_unreadable' end
        return text
    end
    return {
        read=read,
        diagnostics=diagnostics,
        write=function(text)
            if type(text)~='string' or #text>65536 then return false,'invalid_state' end
            diagnostics.write_attempted=true
            diagnostics.expected_length=#text
            diagnostics.readback_verified=false
            local wrote,why=call('WriteFileAtPath',path,text)
            diagnostics.write_return_type=type(wrote)
            diagnostics.write_return_true=wrote==true
            diagnostics.write_error=why
            if wrote~=true then return false,why or 'write_failed' end
            local actual=read()
            if actual~=text then return false,'write_readback_mismatch' end
            diagnostics.readback_verified=true
            return true
        end
    }
end


        local weaponMap=member(controller,'WeaponAvatarItemList')
        local changed=false
        if opt.weapons() and type(member(weaponMap,'Add'))=='function' then
            for base,id in pairs(opt.selected_weapons()) do
                if get(weaponMap,base)~=id then
                    remember(state,'WeaponAvatarItemList',weaponMap,base,id)
                    if put(weaponMap,base,id) and get(weaponMap,base)==id then
                        changed=true;P.diagnostics.weapon_map_writes=P.diagnostics.weapon_map_writes+1
                    end
                end
            end
        elseif weaponMap~=nil then restore(state,'WeaponAvatarItemList',weaponMap) end
        -- UI projection must not broadcast a gameplay equipment change: the
        -- native listener can rebuild a freshly picked-up weapon from stock.
        if changed then P.diagnostics.weapon_ui_map_changed=true end
        local vehicleMap=member(controller,'VehicleAvatarSkinList')
        local selectedMap=member(controller,'VehicleAvatarList')
        if not opt.vehicles() then
            if vehicleMap~=nil then restore(state,'VehicleAvatarSkinList',vehicleMap) end
            if selectedMap~=nil then restore(state,'VehicleAvatarList',selectedMap) end
            return true
        end
        if type(member(vehicleMap,'Add'))~='function' then
            P.diagnostics.vehicle_status='controller_vehicle_skin_map_unavailable';return false
        end
        local groups=opt.vehicle_lists()
        local rows,total=0,0

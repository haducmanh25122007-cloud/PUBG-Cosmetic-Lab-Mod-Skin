        if not got or type(rows)~='table' or #rows==0 then
            V.diagnostics.filter_status='premium_metadata_not_ready';return false
        end
        catalog={};baseBySkin={};records={}
        for _,row in ipairs(rows) do
            catalog[row.base]=catalog[row.base] or {};catalog[row.base][#catalog[row.base]+1]=row
            baseBySkin[row.id]=row.base

                end
                local rows,seen={},{}
                local owned=member(self,'isOnlyShowGot')~=false
                for _,cfg in ipairs(state.full) do
                    local g=group_for_cfg(cfg)
                    local group=tonumber(member(cfg,'GroupID'))
                    local id=member(cfg,'ItemID');if id then known[id]=group or false end
                    if id and type(opt.current_state)=='function' then
                        local got,state=pcall(opt.current_state,id);if got and state then known[state]=group or false end
                    end
                    local modded=g~=nil
                    if group and not seen[group] and modded==owned then
                        -- Preserve native sort/config fields without changing its cache.
                        local row={}
                        if type(cfg)=='table' then
                            local k,v=next(cfg);local count=0
                            while k~=nil and count<256 do row[k]=v;count=count+1;k,v=next(cfg,k) end
                        end
                        for _,key in ipairs({'ID','GroupID','ItemID','Level'}) do row[key]=row[key] or member(cfg,key) end
                        if g then row.ItemID=g.id;row.GroupID=g.group_id end
                        row.__manhduathoi_modded=modded
                        rows[#rows+1]=row;seen[group]=true
                    end
                end
                result[1]=rows;W.diagnostics.row_count=#rows
                W.diagnostics.filter=owned and 'modded' or 'unmodded'
                state[owned and 'modded' or 'unmodded']=rows
            end
            return table.unpack(result,1,result.n)
        end
        local info=member(cls,'GetItemInfo')
        if type(info)=='function' then
            cls.GetItemInfo=function(self,cfg,...)
                if opt.enabled() then
                    local g=group_for_cfg(cfg)
                    if g then return opt.record(g.id),false end
                    -- Local filter meaning is MODDED/UNMODDED, not server ownership.
                    return nil,false
                end
                return info(self,cfg,...)
            end
        end
        cls.CreateUpgradeItemData=function(self,cfg,...)
            local g=opt.enabled() and group_for_cfg(cfg)
            if g then
                local record=opt.record(g.id)
                local item=opt.item(g.id)
                if record and item then
                    W.diagnostics.status='workshop_local_max_level_rows'
                    return {resID=g.id,instID=record.insID,count=1,groupID=g.group_id,
                        subType=member(item,'ItemSubType'),sortID=tonumber(member(cfg,'ID')) or g.id,
                        __manhduathoi_local=true}
                end
            end
            if opt.enabled() and member(cfg,'__manhduathoi_modded')==false then
                local item=opt.item(member(cfg,'ItemID'))
                return {resID=member(cfg,'ItemID'),groupID=member(cfg,'GroupID'),
                    subType=member(item,'ItemSubType'),sortID=member(cfg,'ID'),
                    __manhduathoi_local=true,__manhduathoi_unmodded=true}
            end
            return create(self,cfg,...)
        end
        local update=member(cls,'OnUpdateWeaponItem')
        if type(update)=='function' then
            cls.OnUpdateWeaponItem=function(self,widget,index,...)
                local result=table.pack(update(self,widget,index,...))
                local read,row=call(member(self,'ScrollBoxWeapon'),'GetItemData',index)
                if opt.enabled() and read and member(row,'__manhduathoi_local') then
                    local locked=member(row,'__manhduathoi_unmodded')==true
                    call(self,'SetWidgetVisible',member(widget,'WidgetSwitcher_1'),locked)
                    call(member(widget,'WidgetSwitcher_1'),'SetActiveWidgetIndex',0)
                    call(self,'SetWidgetVisible',member(widget,'Mask'),locked)
                    call(self,'SetWidgetVisible',member(widget,'CanvasPanel_Freeze'),false)
                    W.diagnostics.lock_render_updates=(W.diagnostics.lock_render_updates or 0)+1
                end
                return table.unpack(result,1,result.n)
            end
        end
        local counts=member(cls,'InitWeaponSubTypeTabData')
        if type(counts)=='function' then
            cls.InitWeaponSubTypeTabData=function(self,...)
                local result=table.pack(counts(self,...))
                if opt.enabled() then
                    local got,list=call(self,'GetAllPageItemList');local sums={[0]=0}
                    if got and type(list)=='table' then
                        for _,cfg in ipairs(list) do
                            local sub=member(opt.item(member(cfg,'ItemID')),'ItemSubType')
                            if sub~=nil then sums[0]=sums[0]+1;sums[sub]=(sums[sub] or 0)+1 end
                        end                    end
                    local map=member(self,'ItemUpgradeTabCountMap')
                    if type(map)=='table' then for key in pairs(map) do map[key]=sums[key] or 0 end end
                    W.diagnostics.display_counts=sums
                end
                return table.unpack(result,1,result.n)
            end
        end
        local toggle=member(cls,'ToggleIsOnlyShowGot')
        if type(toggle)=='function' then
            cls.ToggleIsOnlyShowGot=function(self,...)
                local result=table.pack(toggle(self,...))
                if opt.enabled() then
                    call(self,'InitWeaponSubTypeTabData')
                    call(member(self,'ExtendedLoopScrollBox_TabList'),'RefreshAllSubItems')
                end
                return table.unpack(result,1,result.n)
            end
        end
        local updateList=member(cls,'UpdateItemList')
        if type(updateList)=='function' then
            cls.UpdateItemList=function(self,...)
                if opt.enabled() then
                    -- The native empty-list branch returns BEFORE SetData.
                    -- Clear first so it cannot leave the previous 21 cards.
                    call(member(self,'ScrollBoxWeapon'),'SetData',{})
                    self.CurSelectWeaponID=nil
                end
                local result=table.pack(updateList(self,...))
                if opt.enabled() then
                    call(self,'InitWeaponSubTypeTabData')
                    call(member(self,'ExtendedLoopScrollBox_TabList'),'RefreshAllSubItems')
                    W.diagnostics.list_revision=(W.diagnostics.list_revision or 0)+1
                    W.diagnostics.previous_list_cleared=true
                end
                return table.unpack(result,1,result.n)
            end
        end
        cls.UpdateWeaponShapeComp=function(self,...)
            local result=table.pack(shape(self,...))
            local g=opt.enabled() and selected(self)
            if g then
                self.CurSelectWeaponID=g.id
                W.diagnostics.selected_skin_id=g.id;W.diagnostics.selected_base_id=g.base
                W.diagnostics.status='workshop_max_level_model_requested_unverified'
            end
            return table.unpack(result,1,result.n)
        end
        cls.GetCurItemEffectLevel=function(self,...)
            local g=opt.enabled() and selected(self)
            if g then return g.level end
            return level(self,...)
        end
        -- A preview row must never reach account upgrade/refit/use operations.
        for _,name in ipairs({'OnClickUpgrade','NormalUpgradeProcess','OnClickButtonRefit',
            'OnClickButtonUse','OnClickButtonCantUse'}) do
            local original=member(cls,name)
            if type(original)=='function' then
                cls[name]=function(self,...)
                    if shadow(self) then
                        W.diagnostics.blocked_action=name
                        if type(opt.notice)=='function' then pcall(opt.notice,'Preview only | Chi xem truoc skin') end
                        return
                    end
                    return original(self,...)
                end
            end
        end
        local inst=member(cls,'GetCurSelectWeaponInstID')
        if type(inst)=='function' then
            cls.GetCurSelectWeaponInstID=function(self,...)
                if shadow(self) then return nil end
                return inst(self,...)
            end
        end
        local click=member(cls,'DoClickWeaponItem')
        if type(click)=='function' then
            cls.DoClickWeaponItem=function(self,...)
                local result=table.pack(click(self,...))
                local g=opt.enabled() and selected(self)
                if g then pcall(opt.select,g.id,g.base) end
                return table.unpack(result,1,result.n)
            end
        end
        bound[cls]=true
        if live then W.diagnostics.live_bindings=(W.diagnostics.live_bindings or 0)+1
        else W.diagnostics.installed=true end
        W.diagnostics.status=live and 'workshop_live_instance_bound' or 'workshop_preview_wrapped'
        return true
    end
    function W.install()
        if W.diagnostics.installed then return true end
        local got,cls=pcall(opt.require,'client.slua.umg.upgrade.item_upgrade')
        if not got or type(cls)~='table' then W.diagnostics.status='workshop_class_unavailable';return false end
        return W.bind(cls,false)
    end
    local depotInstalled=false
    local function install_depot()
        if depotInstalled or type(opt.depot)~='function' then return end
        local got,depot=pcall(opt.depot)
        local original=got and member(depot,'GetHallDepotItemDataByResIDAndTimeliness')
        if type(original)~='function' then return end
        depot.GetHallDepotItemDataByResIDAndTimeliness=function(self,id,...)
            local shown,visible=call(active,'IsShow')
            if opt.enabled() and shown and visible==true then
                local g=type(opt.group_for_id)=='function' and opt.group_for_id(id) or nil
                if not g and known[id] then g=opt.groups()[known[id]] end
                if g then return opt.record(g.id) end

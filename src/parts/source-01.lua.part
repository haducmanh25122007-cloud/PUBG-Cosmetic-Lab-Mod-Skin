        local n=0
        for _,name in ipairs({'GetHallDepotItemDataByInsID','GetValidHallDepotItemDataByInsID'}) do
            local original=member(depot,name)
            if type(original)=='function' then
                depot[name]=function(self,id,...)
                    local v=tonumber(id)

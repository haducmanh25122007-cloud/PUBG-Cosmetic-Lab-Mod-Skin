                        if not applied then A.diagnostics.status='attachment_override_api_unavailable';return false,A.diagnostics.status end
                        if type(member(c,'ApplyAttachment'))=='function' then
                            local rendered=call(c,'ApplyAttachment',handle)
                            if not rendered then A.diagnostics.status='native_attachment_apply_failed';return false,A.diagnostics.status end
                            A.diagnostics.native_part_render_requests=(A.diagnostics.native_part_render_requests or 0)+1

    local Core=(function()
-- Original selection/persistence engine. Lua 5.3. No network or game globals.
local Core = {}
Core.__index = Core
local kinds = {weapon=true,outfit=true,backpack=true,helmet=true,grenade=true,parachute=true,vehicle=true}
local function integer(v)
    return type(v)=='number' and v>0 and v<=2147483647 and v%1==0
end
local function key(kind,base) return kind..':'..base end
local function copy(t)
    local out={}; for k,v in pairs(t) do out[k]=v end; return out
end
local function invoke(fn,...)
    if type(fn)~='function' then return false,'missing_callback' end
    local ok,a,b=pcall(fn,...)
    if not ok then return false,'callback_error: '..tostring(a) end
    return a,b
end
function Core.new(catalog,storage,adapters)
    assert(type(storage)=='table','storage required')
    local self=setmetatable({catalog={},selected={},storage=storage,adapters=adapters or {}},Core)
    for _,r in ipairs(catalog) do
        assert(kinds[r.kind] and integer(r.base_id) and integer(r.skin_id),'invalid catalog row')
        local k=key(r.kind,r.base_id)
        self.catalog[k]=self.catalog[k] or {}
        assert(not self.catalog[k][r.skin_id],'duplicate catalog identity')
        self.catalog[k][r.skin_id]=copy(r)
    end
    return self
end
function Core:list(kind,base)
    local rows={}
    for _,r in pairs(self.catalog[key(kind,base)] or {}) do rows[#rows+1]=copy(r) end
    table.sort(rows,function(a,b) return a.skin_id<b.skin_id end)
    return rows
end
function Core:encode(selection)
    local lines={'MANHDUATHOI_SKINS_V1'}
    local keys={}; for k in pairs(selection or self.selected) do keys[#keys+1]=k end
    table.sort(keys)
    for _,k in ipairs(keys) do lines[#lines+1]=k..':'..(selection or self.selected)[k] end
    return table.concat(lines,'\n')..'\n'
end
function Core:restore()
    local raw,err=invoke(self.storage.read)
    if type(raw)~='string' then return false,err or 'read_failed' end
    if #raw>65536 then return false,'state_too_large' end
    local lines={}; for line in raw:gmatch('[^\r\n]+') do lines[#lines+1]=line end
    if lines[1]~='MANHDUATHOI_SKINS_V1' then return false,'invalid_header' end
    local nextSelection={}
    for i=2,#lines do
        local kind,base,skin=lines[i]:match('^([a-z]+):([0-9]+):([0-9]+)$')
        base,skin=tonumber(base),tonumber(skin)
        if not kinds[kind] or not integer(base) or not integer(skin) then return false,'invalid_row' end
        local k=key(kind,base)
        if nextSelection[k] then return false,'duplicate_state_row' end
        if not (self.catalog[k] and self.catalog[k][skin]) then return false,'unknown_skin' end
        nextSelection[k]=skin
    end
    self.selected=nextSelection
    return true
end
-- Save desired selection first. Applying it is a separate, observable result.
function Core:_select(kind,base,skin,persist)
    if not kinds[kind] or not integer(base) or not integer(skin) then return false,'invalid_selection' end
    local k=key(kind,base)
    if not (self.catalog[k] and self.catalog[k][skin]) then return false,'unknown_skin' end
    local adapter=self.adapters[kind]
    if not adapter or type(adapter.apply)~='function' or type(adapter.current)~='function' then
        return false,'category_not_connected'
    end
    local nextSelection=copy(self.selected); nextSelection[k]=skin
    if persist then
        local ok,err=invoke(self.storage.write,self:encode(nextSelection))
        if ok~=true then return false,err or 'write_failed' end
    end
    self.selected=nextSelection
    return true,persist and 'saved_not_yet_applied' or 'session_only_not_yet_applied'
end
function Core:select(kind,base,skin)
    return self:_select(kind,base,skin,true)
end
-- Explicit in-memory selection for an accepted trial when persistence fails.
-- Same catalog and adapter validation; never claims the selection was saved.
function Core:select_session(kind,base,skin)
    return self:_select(kind,base,skin,false)
end
-- Caller supplies a live LOCAL object context after its creation/equipment event.
-- No background polling, re-entrant loops, automatic retries or server requests.
function Core:on_ready(kind,base,context)
    if not kinds[kind] or not integer(base) then return {applied=false,status='invalid_target'} end
    local k=key(kind,base)
    local skin=self.selected[k]
    if not skin then return {applied=false,status='no_selection'} end
    local adapter=self.adapters[kind]
    if not adapter then return {applied=false,status='category_not_connected'} end
    local current,err=invoke(adapter.current,context,base)
    if current~=0 and not integer(current) then return {applied=false,status=err or 'target_not_ready'} end
    if current==skin then return {applied=true,status='already_applied',skin_id=skin} end
    local ok,why=invoke(adapter.apply,context,copy(self.catalog[k][skin]))
    if ok~=true then return {applied=false,status=why or 'apply_failed',skin_id=skin} end
    local actual=invoke(adapter.current,context,base)
    if actual~=skin then return {applied=false,status='awaiting_confirmation',skin_id=skin} end
    return {applied=true,status='id_confirmed_visual_unverified',skin_id=skin}
end
return Core


    local notices={}
    local function notice_once(key,message)
        if notices[key] or type(opt.notice)~='function' then return end
        local ok,shown=pcall(opt.notice,message)
        if ok and shown==true then notices[key]=true end
        note('notice_call_ok',ok and shown==true)
    end
    function I.begin()
        notices={};I.started=true
        notice_once('begin','Loading skins | Dang nap skin')
    end

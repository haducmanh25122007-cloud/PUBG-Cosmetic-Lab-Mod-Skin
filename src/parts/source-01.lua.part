        local bound=call(image,'SetBrushResourceObject',s.texture)
        if not bound then return false end
        R.diagnostics.bindings=R.diagnostics.bindings+1
        R.diagnostics.status='animated_weapon_capture_requested_visual_unverified'
        return true,s.texture
    end
    return R
end


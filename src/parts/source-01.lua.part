                -- Never use a previously projected owned/unowned list as the
                -- next filter's source. The native manager owns the full table.
                local got,manager=call(self,'GetItemUpgradeMgr')
                local read,full=call(got and manager,'GetAllUpgradeItemsExceptPadora')
                local source=read and type(full)=='table' and full or result[1]
                if not snapshots[self] then snapshots[self]={} end
                local state=snapshots[self]

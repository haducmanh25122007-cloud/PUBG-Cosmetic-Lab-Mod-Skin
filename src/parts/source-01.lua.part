    local lobby_factory=(function()
-- Local lobby appearance through the native character's MAIN slot.
-- Rebuild only on selection/scene/reset, then retain the confirmed actor.
return function(opt)
    local L={diagnostics={requests=0},clock=0}
    local desired,modelSeen,pending,cleaned
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);if ok then return v end;return nil
    end
    local function call(o,name,...)
        local fn=member(o,name);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function context()
        if type(opt.in_lobby)=='function' and not opt.in_lobby() then return nil,'outside_lobby' end
        if not opt.local_controller(opt.controller()) then return nil,'lobby_local_controller_unavailable' end
        local uid=opt.uid();if uid==nil then return nil,'lobby_local_uid_unavailable' end
        local loaded,team=pcall(opt.require,'client.logic.avatar.logic_team_avatar_manager')
        local get=loaded and member(team,'GetAvatarByUid')
        if type(get)~='function' then return nil,'lobby_avatar_manager_unavailable' end
        local got,avatar=pcall(get,uid)
        local ready,model=call(avatar,'GetModel')
        local manager=member(model,'BP_LobbyWeaponManager')

            if normal then call(entry,'SetWidgetVisible',normal,false,true) end
            state.id=id;P.diagnostics.icon_requests=P.diagnostics.icon_requests+1
        end
        state.drawing=false
    end
    local function bind_entry(entry)
        if entries[entry] then return end
        local state={};entries[entry]=state
        for _,name in ipairs({'RefreshTabIcon','OnClothesUpdate'}) do
            local original=member(entry,name)
            if type(original)=='function' then
                if name=='RefreshTabIcon' then state.original_refresh=original end
                entry[name]=function(self,...)
                    local id=selected_for_tab(self)
                    if id then draw(self,id,true);return end
                    return original(self,...)

            local original=good and member(logic,key)
            if type(original)=='function' then
                logic[key]=function(self,id,...)
                    if opt.enabled() and V.allowed(id) then
                        if key=='IsCanUse' then return true end
                        return -id
                    end
                    return original(self,id,...)
                end
            end
        end
        if type(put)=='function' then
            logic.wardrobe_puton_req=function(self,ins,...)

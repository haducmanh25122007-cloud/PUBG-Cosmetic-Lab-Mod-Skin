    local state_factory=(function()
-- Small, validated local preferences. Never executes state text as Lua.
return function(opt)
    local S={weapons={},vehicles={},cosmetics={},emotes={},toggles={},diagnostics={persisted=false}}
    local helper=opt.import('ScriptHelperClient')
    local function member(o,k) if o==nil then return nil end;local ok,v=pcall(function() return o[k] end);return ok and v or nil end
    local function static(k,...)
        local fn=member(helper,k);if type(fn)~='function' then return false,nil end
        return pcall(fn,...)
    end
    local ok,dir=static('GetPureIOSDocumentsDirectory')
    local path=ok and type(dir)=='string' and dir:sub(1,1)=='/' and dir:gsub('/+$','')..'/ManhDuathoi-Skin-Options-v2.state' or nil
    local fs=opt.io==nil and io or opt.io
    local function read_io()
        if not path or type(member(fs,'open'))~='function' then return nil end
        local good,text=pcall(function()
            local f=fs.open(path,'rb');if not f then return nil end
            local v=f:read(65537);f:close();return v
        end)
        return good and text or nil
    end
    local function read_native()
        local got,text=static('LoadFileToStringByFullPath',path)
        if got and type(text)=='string' and text~='' then return text end
        local got,bytes=static('LoadFileToArrayByFullPath',path)
        local n=member(bytes,'Num');local getter=member(bytes,'Get')
        if got and type(n)=='function' and type(getter)=='function' then
            local counted,size=pcall(n,bytes)
            if counted and type(size)=='number' and size>=0 and size<=65536 then
                local a={}
                for i=0,size-1 do
                    local read,v=pcall(getter,bytes,i)
                    if not read or type(v)~='number' or v<0 or v>255 or v%1~=0 then return nil end
                    a[#a+1]=string.char(v)
                end
                return table.concat(a)
            end
        end
    end
    local function encode()
        local lines={'MANHDUATHOI_STATE_V2'}
        for base,id in pairs(S.weapons) do lines[#lines+1]='weapon:'..base..':'..id end
        for base,id in pairs(S.vehicles) do lines[#lines+1]='vehicle:'..base..':'..id end
        for slot,id in pairs(S.cosmetics) do lines[#lines+1]='cosmetic:'..slot..':'..id end
        for slot,id in pairs(S.emotes) do lines[#lines+1]='emote:'..slot..':'..id end
        for key,value in pairs(S.toggles) do lines[#lines+1]='toggle:'..key..':'..(value and '1' or '0') end
        if S.focus and S.weapons[S.focus] then lines[#lines+1]='focus:weapon:'..S.focus end
        local first=table.remove(lines,1);table.sort(lines);table.insert(lines,1,first)
        return table.concat(lines,'\n')..'\n'
    end
    function S.restore()
        if not path then return false,'state_path_unavailable' end
        local text=read_io()
        S.diagnostics.read_backend=type(text)=='string' and text~='' and 'lua_io' or 'native'
        if type(text)~='string' or text=='' then text=read_native() end
        if type(text)~='string' or text=='' or #text>65536 then return false,'state_unreadable' end
        if text:match('^([^\r\n]+)')~='MANHDUATHOI_STATE_V2' then return false,'state_header_invalid' end
        local w,v,t,seen={},{},{},{}
        local c,e={},{}
        local focus
        for line in text:gmatch('[^\r\n]+') do
            if line~='MANHDUATHOI_STATE_V2' then
                local kind,key,value=line:match('^([a-z]+):([a-z0-9_]+):([0-9]+)$')
                if not kind then return false,'state_row_invalid' end
                if seen[kind..':'..key] then return false,'state_duplicate' end
                seen[kind..':'..key]=true;local n=tonumber(value)
                if kind=='weapon' and opt.weapon(tonumber(key),n) then w[tonumber(key)]=n
                elseif kind=='vehicle' and opt.vehicle(tonumber(key),n) then v[tonumber(key)]=n
                elseif kind=='cosmetic' and type(opt.cosmetic)=='function' and opt.cosmetic(tonumber(key),n) then c[tonumber(key)]=n
                elseif kind=='emote' and type(opt.emote)=='function' and opt.emote(tonumber(key),n) then e[tonumber(key)]=n
                elseif kind=='toggle' and opt.defaults[key]~=nil and (n==0 or n==1) then t[key]=n==1
                elseif kind=='focus' and key=='weapon' then focus=n
                else return false,'state_selection_invalid' end
            end
        end
        S.weapons=w;S.vehicles=v;S.cosmetics=c;S.emotes=e
        for key,default in pairs(opt.defaults) do
            if t[key]==nil then S.toggles[key]=default else S.toggles[key]=t[key] end
        end
        S.focus=w[focus] and focus or nil
        S.diagnostics.restored=true;S.diagnostics.persisted=true;return true
    end
    function S.save()
        if not path then S.diagnostics.error='state_path_unavailable';return false end
        local payload=encode();local wrote=false
        if type(member(fs,'open'))=='function' then
            local good,value=pcall(function()

    local presentation_factory=(function()
-- View-model selection and native wardrobe tab icons. All writes are confined
-- to local UI rows/widgets; account equipment/instance IDs are never changed.
return function(opt)
    local P={diagnostics={badge_refreshes=0,icon_requests=0,grid_refreshes=0}}
    local tracked={cosmetic={},emote={}}
    local views=setmetatable({},{__mode='k'})
    local entries=setmetatable({},{__mode='k'})
    local function member(o,k)
        if o==nil then return end
        local ok,v=pcall(function() return o[k] end);if ok then return v end
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function identify(data)
        local id=tonumber(member(data,'res_id') or member(data,'resID') or member(data,'ResID'))
        return id,id and opt.meta(id)
    end
    function P.track(data)
        if type(data)~='table' then return end
        local id,r=identify(data);if not r or not tracked[r.kind] then return end
        local group=tracked[r.kind][r.slot]
        if not group then group=setmetatable({},{__mode='k'});tracked[r.kind][r.slot]=group end
        group[data]=id
        local selected
        if opt.enabled(r.kind) then selected=opt.selected(r.kind,r.slot) end
        local localRow=tonumber(member(data,'ins_id') or member(data,'insID'))==-id
        if selected~=nil or localRow then
            local checked=selected==id
            data.isUsing=checked;data.isSelected=checked
            if localRow then data.isRolewear=false;data.showUseCount=false end
            return checked,true
        end
    end
    local function grids(view)
        local result,seen={},{}
        for _,name in ipairs({'LoopScrollGrid_Avatar','LoopScrollGrid_Normal'}) do
            local grid=member(view,name)
            if grid and not seen[grid] then seen[grid]=true;result[#result+1]=grid end
        end
        return result
    end
    local function active(view,state)
        local current=member(state.parent,'curIns')
        if current and current~=view then return false end
        local ok,shown=call(state.parent,'IsShow')
        return not ok or shown~=false
    end
    local function selected_for_tab(entry)
        local cfg=member(entry,'tabConfig')
        if not cfg or not opt.enabled('cosmetic') then return end
        local page,tab=member(cfg,'pageId'),member(cfg,'subTabId')
        for slot,id in pairs(opt.selections('cosmetic')) do
            local r=opt.meta(id)
            if r and r.slot==slot and opt.matches(r,page,tab,cfg) then return id end
        end
    end
    local function draw(entry,id,force)
        local state=entries[entry]
        if not state or state.drawing then return end
        if not force and state.id==id and member(entry,'iconItemID')==id then return end
        local root=member(entry,'UIRoot')
        local icon,normal=member(root,'Image_ItemIcon'),member(root,'Image_Icon')
        if not icon then return end
        local cfg=opt.item(id)
        local path=member(cfg,'ItemSmallIcon')
        local loaded,util=pcall(opt.require,'client.common.ui_util')
        local getter=loaded and member(util,'GetItemSmallIcon')
        local missing=false
        if type(getter)=='function' then
            local ok,value,wait=pcall(getter,id,icon)
            if ok and type(value)=='string' and value~='' then path=value;missing=wait==true end
        end

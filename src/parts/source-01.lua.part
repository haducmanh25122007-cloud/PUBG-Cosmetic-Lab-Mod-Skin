    end
    function P.clear()
        for controller,state in pairs(saved) do
            if opt.local_controller(controller) then
                for name,stored in pairs(state) do restore(state,name,member(controller,name) or stored.map) end
            end
            saved[controller]=nil
        end
    end
    return P
end


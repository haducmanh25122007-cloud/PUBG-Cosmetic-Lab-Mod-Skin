    end
    list_ids=function(value)
        local list=member(value,'SkinList');local ok,n=call(list,'Num');local result={}
        if not ok or type(n)~='number' or n<0 or n>2048 then return end
        for i=0,n-1 do local got,id=call(list,'Get',i);if not got then return end;result[#result+1]=id end
        return result
    end
    local function same(value,ids)
        local old=list_ids(value);if not old or #old~=#ids then return false end
        for i,id in ipairs(ids) do if old[i]~=id then return false end end
        return true
    end
    skin_list=function(ids)
        local ok,struct=pcall(opt.import,'VehicleAvatarSkinList')
        if not ok or struct==nil then return end
        local made,value=pcall(struct)
        if not made then return end
        for _,id in ipairs(ids) do
            local added,result=call(member(value,'SkinList'),'Add',id)
            if not added or result==false then return end
        end
        return value
    end
    local function restore(state,name,map)
        local stored=state[name];if not stored then return end
        local entries=stored.entries

        local baseOk,base=call(w,'GetWeaponID')
        -- Lobby GetWeaponID returned the selected skin ID on the real device.
        if baseOk and type(opt.base_for_skin)=='function' then base=opt.base_for_skin(base) or base end
        local mainOk,main=call(w,'GetWeaponMainAvatarID')
        local defineOk,define=call(w,'GetItemDefineID')
        local comp=member(w,'WeaponAvatarComponent')
        local slotOk,equipped=call(comp,'GetEquippedItemDefineID',7)
        L.diagnostics.readback={base_id=baseOk and base or nil,main_skin_id=mainOk and main or nil,
            define_id=defineOk and member(define,'TypeSpecificID') or nil,

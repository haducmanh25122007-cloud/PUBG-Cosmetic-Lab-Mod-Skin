    local vehicle_dump_factory=(function()
-- Read-only item/vehicle scan. No vehicle/inventory or account modifications.
return function(opt)
    local D={diagnostics={status='not_started'},rows={_array=true},coupe_ids={_array=true}}
    local source,index,count,seen=nil,0,0,{}
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);if ok then return v end;return nil
    end
    local function invoke(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,...)
    end
    local function number_id(v) return type(v)=='number' and v>0 and v<=2147483647 and v%1==0 end
    local function size(list)
        local fn=member(list,'Num')
        if type(fn)=='function' then local ok,n=pcall(fn,list);if ok then return n end end
        if type(list)=='table' then return rawlen(list) end
    end
    local function at(list,i)
        local fn=member(list,'Get')
        if type(fn)=='function' then local ok,v=pcall(fn,list,i);if ok then return v end
        elseif type(list)=='table' then return list[i+1] end
    end
    local function save()
        D.diagnostics.scanned=index;D.diagnostics.vehicle_count=#D.rows;D.diagnostics.coupe_count=#D.coupe_ids
        local report={version='vehicle-id-dump-0.11',status=D.diagnostics.status,
            diagnostics=D.diagnostics,vehicle_rows=D.rows,coupe_skin_ids=D.coupe_ids,
            note='Read-only IDs/metadata; this file does not apply a vehicle skin.'}
        local ok,saved=pcall(opt.save,'ManhDuathoi-Vehicle-Skin-IDs.json',report)
        D.diagnostics.saved=ok and saved==true
    end
    function D.start()
        if source or D.diagnostics.status=='complete' then return true end
        local avatar=opt.import('AvatarUtils')
        if type(member(avatar,'GetVehicleDefaultID'))~='function'
            or type(member(avatar,'GetVehicleBPPathBySkinID'))~='function' then
            D.diagnostics.status='vehicle_metadata_api_unavailable';save();return false
        end
        local business=opt.import('BusinessHelper')
        local names=opt.import('DataTableFunctionLibrary')
        local got,tableObject=invoke(business,'GetDataTable','Item')
        if got and tableObject then
            local results=table.pack(invoke(names,'GetDataTableRowNames',tableObject))
            for i=2,results.n do
                local n=size(results[i]);if type(n)=='number' and n>0 and n<=150000 then source=results[i];count=n;break end
            end
            if not source then
                local results=table.pack(invoke(names,'GetDataTableRowNames',tableObject,nil))
                for i=2,results.n do local n=size(results[i]);if type(n)=='number' and n>0 and n<=150000 then source=results[i];count=n;break end end
            end
        end
        if not source then
            local got,list=invoke(opt.import('BackpackUtils'),'GetItemIDs')
            local n=got and size(list)
            if type(n)=='number' and n>0 and n<=150000 then source=list;count=n;D.diagnostics.source='BackpackUtils.GetItemIDs' end
        else D.diagnostics.source='Item table row names' end
        if not source then D.diagnostics.status='item_id_enumeration_unavailable';save();return false end
        D.diagnostics.total_ids=count;D.diagnostics.status='reading';return true
    end
    function D.step()
        if not source or D.diagnostics.status~='reading' then return end
        local avatar=opt.import('AvatarUtils')
        for _=1,64 do
            if index>=count then D.diagnostics.status='complete';save();return end
            local row=at(source,index);index=index+1
            if type(row)~='string' and type(row)~='number' then
                local ok,text=invoke(opt.import('KismetStringLibrary'),'Conv_NameToString',row)
                if ok then row=text end
            end
            local id=tonumber(row)
            if number_id(id) and not seen[id] then
                seen[id]=true
                local got,base=invoke(avatar,'GetVehicleDefaultID',id)
                if got and number_id(base) and base~=id then
                    local item,baseItem=opt.item(id),opt.item(base)
                    local pathOk,path=invoke(avatar,'GetVehicleBPPathBySkinID',id)
                    local basePathOk,basePath=invoke(avatar,'GetVehicleBPPathBySkinID',base)
                    local itemName,baseName=member(item,'ItemName'),member(baseItem,'ItemName')
                    local text=table.concat({type(itemName)=='string' and itemName or '',
                        type(baseName)=='string' and baseName or '',pathOk and type(path)=='string' and path or '',
                        basePathOk and type(basePath)=='string' and basePath or ''},' '):lower()
                    local coupe=text:find('coupe',1,true)~=nil
                    D.rows[#D.rows+1]={skin_id=id,default_vehicle_id=base,item_name=itemName,
                        default_name=baseName,path=pathOk and path or nil,is_coupe_by_metadata=coupe}
                    if coupe then D.coupe_ids[#D.coupe_ids+1]=id end
                end
            end
        end
        D.diagnostics.scanned=index;D.diagnostics.vehicle_count=#D.rows;D.diagnostics.coupe_count=#D.coupe_ids
        if index%1024<64 then save() end
    end
    return D
end

    end)()
    local kill_factory=(function()
-- Local visual requests triggered ONLY by a received, verified own kill.
-- No synthesized kills, server broadcasts, stats or inventory modifications.
return function(opt)
    local K={diagnostics={kill_events=0,box_requests=0,particle_requests=0,notification_requests=0}}
    local installed=setmetatable({},{__mode='k'})
    local queue,seen,seenOrder={},{},{}
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);if ok then return v end;return nil
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function value(p,a,b) return member(p,a) or member(p,b) end
    local function own_key(controller)
        local key=member(controller,'PlayerKey')
        if type(key)=='number' and key>0 then return key end
        local got,pawn=call(controller,'GetCurPlayerCharacter')
        if not got or not opt.valid(pawn) then got,pawn=call(controller,'GetCurPawn') end
        return got and opt.valid(pawn) and member(pawn,'PlayerKey') or nil
    end
    function K.project(controller,p)
        if not opt.enabled() or not opt.local_controller(controller)
            or (type(opt.announcement_enabled)=='function' and not opt.announcement_enabled()) then return p end
        local causer=value(p,'CauserKey','causerKey')
        if causer~=own_key(controller) or type(causer)~='number' or causer<=0 then return p end
        local base=opt.base(value(p,'CauserWeaponAvatarID','causerWeaponAvatarID'))
            or opt.base(value(p,'AdditionalParam','additionalParam'))
        local skin=base and opt.selected(base);if not skin then return p end
        local out={}
        if type(p)=='table' then for key,v in next,p do out[key]=v end end
        for _,key in ipairs({'causerName','VictimName','FuzzyCauserName','FuzzyVictimName',
            'RealKillerName','CauserNation','VictimNation','DamageType','AdditionalParam','IsHeadShot',
            'ResultHealthStatus','Relationship','PreviousHealthStatus','realKillerNewKillNum',
            'CauserKey','VictimKey','CauserClothAvatarID','CauserType','VictimType',
            'ExpandDataContent','AssistNum','isCausedByDevliver'}) do
            if out[key]==nil then out[key]=member(p,key) end
        end
        out.causerKey=causer;out.victimKey=value(p,'VictimKey','victimKey')
        out.CauserKey=causer;out.VictimKey=out.victimKey
        out.causerWeaponAvatarID=skin;out.CauserWeaponAvatarID=skin
        return out
    end
    local function receive(controller,p)
        if not opt.enabled() or not opt.local_controller(controller) then return end
        local got,pawn=call(controller,'GetCurPlayerCharacter')
        if not got or not opt.valid(pawn) then got,pawn=call(controller,'GetCurPawn') end
        if not got or not opt.valid(pawn) then return end
        local causer,victim=value(p,'CauserKey','causerKey'),value(p,'VictimKey','victimKey')
        if type(causer)~='number' or causer~=own_key(controller) or type(victim)~='number' or victim<=0 then return end
        local eventSkin=value(p,'CauserWeaponAvatarID','causerWeaponAvatarID')
        local base=opt.base(eventSkin) or opt.base(value(p,'AdditionalParam','additionalParam'))
        local skin=base and opt.selected(base)
        if not skin then
            K.diagnostics.status='kill_weapon_not_identified'
            K.diagnostics.unidentified_event={causer_key=causer,victim_key=victim,event_avatar_id=eventSkin,
                additional_param=value(p,'AdditionalParam','additionalParam')}
            return
        end
        local key=tostring(victim)..':'..tostring(skin)..':'..
            tostring(value(p,'realKillerNewKillNum','KillNum') or 0)..':'..
            tostring(member(p,'ResultHealthStatus') or 0)
        local now=type(opt.tick)=='function' and opt.tick() or 0
        if seen[key] and now-seen[key]<=5 then return end
        if seen[key]==nil then
            if #seenOrder>=128 then seen[table.remove(seenOrder,1)]=nil end
            seenOrder[#seenOrder+1]=key
        end
        seen[key]=now
        K.diagnostics.kill_events=K.diagnostics.kill_events+1
        K.diagnostics.last_event={causer_key=causer,victim_key=victim,event_avatar_id=eventSkin,selected_skin_id=skin,base_id=base}
        local announce=type(opt.announcement_enabled)~='function' or opt.announcement_enabled()
        local crate=type(opt.crate_enabled)~='function' or opt.crate_enabled()
        local weapon=announce and eventSkin~=skin and opt.weapon(base)
        if announce and eventSkin==skin then K.diagnostics.notification_status='native_event_already_has_selected_skin' end
        local c=member(weapon,'WeaponAvatarComponent')
        if opt.valid(c) then
            local idOk,define=call(c,'GetEquippedItemDefineID',7)
            if idOk and member(define,'TypeSpecificID')==skin then
                local data=K.project(controller,p)
                local handler=member(c,'OnKilledEvent')
                local handled=false
                if type(handler)=='function' then
                    handled=call(c,'OnKilledEvent',data)
                    if handled then K.diagnostics.native_weapon_kill_handler_requests=(K.diagnostics.native_weapon_kill_handler_requests or 0)+1 end
                end
                local played=not handled and call(c,'AddAction_ParticleByName',7,'KillEffect')
                if played then K.diagnostics.particle_requests=K.diagnostics.particle_requests+1 end
                local manager=member(c,'EffectManager')
                local fn=member(manager,'OnThisWeaponKilledOther')
                if handled then K.diagnostics.notification_status='weapon_kill_handler_requested_unverified'
                elseif type(fn)=='function' then
                    local ok=pcall(fn,manager,data)
                    if ok then K.diagnostics.notification_requests=K.diagnostics.notification_requests+1 end
                    K.diagnostics.notification_status=ok and 'native_effect_manager_requested_unverified' or 'native_effect_manager_call_failed'
                else K.diagnostics.notification_status='native_effect_manager_unavailable' end
            end
        end
        local health=member(p,'ResultHealthStatus')
        if crate and (health==nil or health==2) and #queue<32 then
            queue[#queue+1]={world=pawn,victim=victim,causer=causer,skin=skin,age=0}
        end
        K.diagnostics.status='own_kill_received_waiting_for_tomb_box'
    end
    function K.hook_class(class)
        if type(class)~='table' or rawget(class,'__manh_kill_hook') then return false end
        local original=member(class,'HandleOnPlayerKilledOthersPlayer')
        if type(original)~='function' then return false end
        class.HandleOnPlayerKilledOthersPlayer=function(self,p,...)
            local projected=K.project(self,p)
            local result=table.pack(original(self,projected,...))
            local ok,err=pcall(receive,self,p)
            if not ok then K.diagnostics.last_error=tostring(err):sub(1,480) end
            return table.unpack(result,1,result.n)
        end
        class.__manh_kill_hook=true;K.diagnostics.controller_handler_hook=true;return true
    end
    local nativeEvents=setmetatable({},{__mode='k'})
    function K.hook_weapon_class()
        if K.diagnostics.weapon_handler_hook or type(opt.require)~='function' then return end
        local ok,class=pcall(opt.require,'GameLua.Mod.Library.GamePlay.Avatar.Component.WeaponAvatarComponent')
        local original=ok and member(class,'OnKilledEvent')
        if type(original)~='function' then return end
        class.OnKilledEvent=function(self,p,...)
            local controller=type(opt.controller)=='function' and opt.controller() or nil
            local got,owner=call(self,'GetOwnerCharacter')
            local projected=p
            if got and opt.valid(owner) and member(owner,'PlayerKey')==own_key(controller) then
                projected=K.project(controller,p)
            end
            if projected~=p then
                local key=tostring(value(projected,'VictimKey','victimKey'))..':'..
                    tostring(member(projected,'realKillerNewKillNum') or 0)..':'..
                    tostring(member(projected,'ResultHealthStatus') or 0)..':'..
                    tostring(value(projected,'CauserWeaponAvatarID','causerWeaponAvatarID'))
                local now=type(opt.tick)=='function' and opt.tick() or 0
                local prior=nativeEvents[self]
                if prior and prior.key==key and now-prior.tick<=5 then return end
                nativeEvents[self]={key=key,tick=now}
            end
            return original(self,projected,...)
        end
        K.diagnostics.weapon_handler_hook=true
    end
    function K.install(controller)
        K.hook_weapon_class()
        if installed[controller] then return true end
        if not opt.local_controller(controller) then return false end
        local delegate=member(controller,'OnPlayerKilledOthersPlayer')
        local fn=member(delegate,'Add')
        if type(fn)~='function' then K.diagnostics.status='kill_delegate_binding_unavailable';return false end
        local ok,handle=pcall(fn,delegate,function(p)
            local good,err=pcall(receive,controller,p)
            if not good then K.diagnostics.status='kill_adapter_error';K.diagnostics.error=tostring(err):sub(1,480) end
        end)
        if ok then installed[controller]=true;K.diagnostics.installed=true;K.diagnostics.status='waiting_for_real_own_kill' end
        return ok
    end
    function K.step()
        if not opt.enabled() then return end
        if type(opt.crate_enabled)=='function' and not opt.crate_enabled() then queue={};K.diagnostics.pending_boxes=0;return end
        for i=#queue,1,-1 do
            local q=queue[i];q.age=q.age+1
            if not opt.valid(q.world) then table.remove(queue,i)
            else
            local box=opt.tomb(q.world,q.victim)
            if opt.valid(box) and member(box,'TargetPlayerKey')==q.victim then
                local causer=member(box,'DamageCauser')
                if opt.valid(causer) and member(causer,'PlayerKey')==q.causer then
                    local path=opt.box_path(q.skin)
                    if type(path)=='string' and path~='' then
                        local ok=call(box,'SetAvatarID',q.skin)
                        if ok then
                            call(box,'OnRep_AvatarId')
                            K.diagnostics.box_requests=K.diagnostics.box_requests+1
                            K.diagnostics.status='tomb_box_skin_requested_unverified'
                            local read,id=call(box,'GetAvatarID');K.diagnostics.box_avatar_readback=read and id or nil
                        else K.diagnostics.status='tomb_box_setter_unavailable' end
                    else K.diagnostics.status='weapon_dead_box_asset_unavailable' end
                    table.remove(queue,i)
                else
                    K.diagnostics.status='tomb_box_causer_unconfirmed'
                    if q.age>=40 then table.remove(queue,i) end
                end
            elseif q.age>=40 then K.diagnostics.status='victim_tomb_box_unavailable';table.remove(queue,i) end
            end
        end
        K.diagnostics.pending_boxes=#queue
    end
    return K
end


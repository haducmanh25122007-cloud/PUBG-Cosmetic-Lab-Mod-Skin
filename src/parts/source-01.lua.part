        return pcall(fn,...)
    end
    local function vector(x,y,z)
        local ctor=rawget(_G,'FVector') or opt.import('Vector')
        local ok,v=pcall(function() return ctor(x,y,z) end);if ok then return v end
    end
    local function release(s)
        if opt.valid(s.actor) then call(s.actor,'K2_DestroyActor') end
        if opt.valid(s.texture) then static('KismetRenderingLibrary','ReleaseRenderTarget2D',s.texture) end
    end
    function R.clear()
        for key,s in pairs(pool) do release(s);pool[key]=nil end
        R.diagnostics.active=0
    end
    function R.finish(tick)
        local active=0
        for key,s in pairs(pool) do
            if tick-s.used>20 then release(s);pool[key]=nil
            elseif s.used==tick then active=active+1 end
        end
        R.diagnostics.active=active
    end
    local function create(world)
        local v=vector(0,0,0);local scale=vector(1,1,1)
        local ctor=rawget(_G,'FRotator') or opt.import('Rotator')
        local made,rot=pcall(function() return ctor(0,0,0) end)
        if not made or not v or not scale then return nil,'capture_native_structs_unavailable' end
        local ok,transform=static('KismetMathLibrary','MakeTransform',v,rot,scale)
        if not ok then return nil,'capture_transform_unavailable' end
        local spawned,actor=static('GameplayStatics','BeginDeferredActorSpawnFromClass',
            world,opt.import('SceneCapture2D'),transform,1,nil)
        if not spawned or not opt.valid(actor) then return nil,'capture_spawn_unavailable' end
        local capture=member(actor,'CaptureComponent2D')
        local textureOk,texture=static('KismetRenderingLibrary','CreateRenderTarget2D',world,256,128,2)
        if not opt.valid(capture) or not textureOk or not opt.valid(texture) then
            release({actor=actor,texture=texture});return nil,'capture_render_target_unavailable'
        end
        local configured=pcall(function()
            capture.bCaptureEveryFrame=false;capture.bCaptureOnMovement=false
            capture.PrimitiveRenderMode=2;capture.ProjectionType=1
            capture.CaptureSource=2;capture.OrthoWidth=200;capture.TextureTarget=texture
        end)
        local finished=static('GameplayStatics','FinishSpawningActor',actor,transform)
        if not configured or not finished then release({actor=actor,texture=texture});return nil,'capture_initialization_failed' end
        R.diagnostics.created=R.diagnostics.created+1
        return {actor=actor,capture=capture,texture=texture,used=opt.tick(),rendered=-100}
    end
    function R.render(image,base,skin,world,tick)
        local weapon=opt.weapon(base,skin)
        if not opt.valid(weapon) then return false end
        local got,mesh=call(weapon,'GetWeaponMeshComponent')
        if not got or not opt.valid(mesh) then return false end
        local component=member(weapon,'WeaponAvatarComponent')
        local ready,loaded=call(component,'IsAvatarAllMeshLoaded')
        if not ready or loaded~=true then return false end
        local gotEntity,entity=call(component,'GetAvatarEntity',7,-1)
        local master=gotEntity and member(entity,'MeshComponent')
        if opt.valid(master) then mesh=master end
        local s=pool[base]
        if not s or not opt.valid(s.actor) or not opt.valid(s.texture) then            if s then release(s);pool[base]=nil end
            local n=0;for _ in pairs(pool) do n=n+1 end
            if n>=2 then return false end
            local why;s,why=create(world)
            if not s then R.diagnostics.status=why;return false end
            pool[base]=s
        end
        s.used=tick
        if s.weapon~=weapon then
            if s.weapon then call(s.capture,'RemoveShowOnlyActorComponents',s.weapon) end
            local ok=call(s.capture,'ShowOnlyActorComponents',weapon)
            if not ok then return false end
            s.weapon=weapon;s.rendered=-100
        end
        if tick>s.rendered then
            -- Attachments can recreate components without recreating the actor.
            -- Refresh the capture's component set, without loading any assets.
            call(s.capture,'RemoveShowOnlyActorComponents',weapon)
            call(s.capture,'ShowOnlyActorComponents',weapon)
            call(s.capture,'ShowOnlyComponent',mesh)
            local located,center=call(mesh,'K2_GetComponentLocation')
            local directed,right=call(mesh,'GetRightVector')
            if not located or not directed then return false end
            local bounds=table.pack(static('KismetSystemLibrary','GetComponentBounds',mesh,nil,nil,nil))
            if bounds[1] and type(member(bounds[2],'X'))=='number' then center=bounds[2] end
            local x,y,z=member(center,'X'),member(center,'Y'),member(center,'Z')
            local rx,ry,rz=member(right,'X'),member(right,'Y'),member(right,'Z')
            if type(x)~='number' or type(y)~='number' or type(z)~='number'
                or type(rx)~='number' or type(ry)~='number' or type(rz)~='number' then return false end
            local eye=vector(x+rx*250,y+ry*250,z+rz*250)
            local rotated,rotation=static('KismetMathLibrary','FindLookAtRotation',eye,center)
            if not rotated then return false end
            local positioned=call(s.actor,'K2_SetActorLocationAndRotation',eye,rotation,false,true,nil)
            if not positioned then return false end

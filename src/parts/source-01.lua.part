        local kind=V.allowed(id)
        if not opt.enabled() or not kind then return false end
        if not opt.choose(kind,id) then return false end
        for _,s in pairs(states) do s.requested=false;s.tries=0;s.tick=-100 end
        if type(opt.changed)=='function' then pcall(opt.changed,kind,id) end
        if view or (type(opt.in_lobby)=='function' and opt.in_lobby()) then V.force_preview(view,id) end
        return true
    end
    function V.force_preview(view,id)
        if not V.allowed(id) then return false end
        local now=type(opt.tick)=='function' and opt.tick() or V.clock
        if V.diagnostics.preview_skin_id==id and now-(V.preview_tick or -100)<10 then return true end
        local got,logic=pcall(opt.require,'client.slua.logic.wardrobe.logic_wardrobe_new')
        if not got then return false end
        local none=member(member(logic,'VehicleSceneType'),'None')
        if none~=nil then call(logic,'SetCurrSceneType',none) end

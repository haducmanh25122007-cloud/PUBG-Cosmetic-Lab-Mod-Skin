            member(cls,'UpdateWeaponShapeComp'),member(cls,'GetCurItemEffectLevel')
        if type(all)~='function' or type(create)~='function' or type(shape)~='function' or type(level)~='function' then
            W.diagnostics.status='workshop_preview_methods_unavailable';return false
        end
        cls.GetAllPageItemList=function(self,...)
            local result=table.pack(all(self,...))

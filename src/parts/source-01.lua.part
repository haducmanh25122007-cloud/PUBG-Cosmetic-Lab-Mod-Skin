            -- Snapshot plain IDs before Add, never keep Get's struct view.
            if name=='VehicleAvatarSkinList' then
                entries[key]={original_ids=old~=nil and list_ids(old) or nil,original_present=old~=nil}
            else entries[key]={original=old} end

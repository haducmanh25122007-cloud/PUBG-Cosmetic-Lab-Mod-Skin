        end
        I.display_count=count
        note('wardrobe_display_count',count)
        I.row_stage='rows_ready'
        return rows,template
    end
    local function selected_local(id)
        local row=depot[tonumber(id)]
        if not row then return false end
        if opt.enabled() and normal_mode() then
            local ok,selected=pcall(opt.select,row.res_id)
            if ok and selected then
                for view in pairs(views) do pcall(refresh,view) end
                note('wardrobe_status','local_skin_selected')
                if type(opt.preview)=='function' then
                    local called,requested,why=pcall(opt.preview,row.res_id)
                    note('lobby_preview_call_ok',called and requested==true)
                    note('lobby_preview_status',called and why or 'lobby_preview_error')
                end
            else note('wardrobe_status','local_selection_failed') end
        end
        -- UI-only handles are always consumed even when stopped/share mode.
        return true
    end
    local function install_logic(wardrobe)
        local logic=load('client.slua.logic.wardrobe.logic_wardrobe_gun')
        if logic and not I.diagnostics.thumbnail_info_hook then
            local init=member(logic,'InitGunInfo')
            if type(init)=='function' then
                logic.InitGunInfo=function(self,data,...)
                    local result=table.pack(init(self,data,...))
                    if opt.enabled() and normal_mode() and member(data,'resID')==opt.base then
                        data.skinResID=opt.selected() or 0
                    end
                    return table.unpack(result,1,result.n)
                end
                I.diagnostics.thumbnail_info_hook=true
            end
        end
        if not I.diagnostics.selection_getter_hook then
            local original=member(logic,'GetSkinIdByWeaponID')
            if type(original)=='function' then
                logic.GetSkinIdByWeaponID=function(self,base,...)
                    local skin=opt.selected()
                    if base==opt.base and opt.enabled() and normal_mode() and skin and I.by_skin and I.by_skin[skin] then
                        I.record_for_skin(skin);return -skin
                    end
                    return original(self,base,...)
                end
                I.diagnostics.selection_getter_hook=true
            end
        end
        if logic and not I.diagnostics.wardrobe_count_hook then
            local getCount=member(logic,'GetSubTabItemCount')
            if type(getCount)=='function' then
                logic.GetSubTabItemCount=function(self,base,...)
                    local result=table.pack(getCount(self,base,...))
                    if base==opt.base and opt.enabled() and normal_mode() then
                        local ready,prepared=pcall(I.prepare)
                        if ready and prepared then
                            result[1]=I.display_count or #I.prepared;result.n=math.max(result.n,1)
                            note('wardrobe_count_returned',result[1])
                            note('wardrobe_count_error',nil)
                        elseif not ready then note('wardrobe_count_error',error_text(prepared)) end
                    end
                    return table.unpack(result,1,result.n)
                end
                I.diagnostics.wardrobe_count_hook=true
            end
        end
        if I.diagnostics.logic_hooks or not wardrobe or not I.diagnostics.depot_hooks then return end
        local armory=load('client.logic.armory.logic_armory')
        local get=member(armory,'GetSkinListByWeaponID')
        local skins=member(logic,'GetSkinList')
        local install=member(armory,'install_weapon_skin')
        if type(get)~='function' or type(skins)~='function' or type(install)~='function' then
            note('logic_status','native_wardrobe_logic_unavailable');return
        end
        armory.install_weapon_skin=function(request,base,id,...)
            if selected_local(id) then return end
            return install(request,base,id,...)
        end
        local uninstall=member(armory,'uninstall_weapon_skin')
        if type(uninstall)=='function' then
            armory.uninstall_weapon_skin=function(request,base,...)
                if opt.enabled() and normal_mode() and base==opt.base and opt.selected() then
                    note('stock_unselect_consumed',true);return
                end
                return uninstall(request,base,...)
            end
        end
        local theme=load('client.logic.lobby.hall_theme_utils')
        local wear=member(theme,'IsWeaponWear')
        if type(wear)=='function' then
            theme.IsWeaponWear=function(ins,...)
                local n=tonumber(ins)
                if opt.enabled() and normal_mode() and n and n<0 and opt.allowed[-n] then
                    return opt.selected()==-n
                end
                return wear(ins,...)
            end
            note('selected_badge_getter_hook',true)
        end
        local change=member(armory,'HandleWeaponSkinChange')
        if type(change)=='function' then
            armory.HandleWeaponSkinChange=function(request,base,id,...)
                if selected_local(id) then return end
                return change(request,base,id,...)
            end
        end
        armory.GetSkinListByWeaponID=function(base,...)
            local result=table.pack(get(base,...))
            if base==opt.base and opt.enabled() and normal_mode() and result[1]==nil then
                result[1]={};result.n=math.max(result.n,1)
            end
            return table.unpack(result,1,result.n)
        end
        logic.GetSkinList=function(self,list,preference,base,source,...)
            local result=table.pack(skins(self,list,preference,base,source,...))
            if base==opt.base and opt.enabled() and normal_mode() then
                note('logic_refresh_calls',(I.diagnostics.logic_refresh_calls or 0)+1)
                local ok,rows=pcall(merge_rows,result[1] or {},wardrobe)
                note('wardrobe_rows_stage',I.row_stage)
                if ok and rows and #rows>0 then
                    note('wardrobe_rows_error',nil)
                    result[1]=rows;result.n=math.max(result.n,1)
                    note('wardrobe_row_count',#rows)
                    note('wardrobe_status','native_logic_rows_returned_visual_unverified')
                    I.result('wardrobe',true,'native_logic_rows_returned')
                else
                    if not ok then note('wardrobe_rows_error',error_text(rows)) end
                    I.result('wardrobe',false,ok and 'skin_rows_unavailable' or 'skin_rows_error')
                end
            end
            return table.unpack(result,1,result.n)
        end
        I.diagnostics.logic_hooks=true
        note('logic_status','native_wardrobe_logic_wrapped')
    end
    local function populate(view,base,wardrobe)
        if base~=opt.base or not opt.enabled() or not normal_mode() then return end
        local visible,show=call(view,'IsShow');if not visible or not show then return end
        if not I.prepare() then note('wardrobe_status',I.diagnostics.catalogue_status);return end
        local got,template=call(view,'GetItemData',1)
        if not got or not row_id(template) or member(template,'__manhduathoi_local') then
            template=views[view] and views[view].template
        end
        local existing={}
        local countOk,count=call(member(view,'LoopScrollGrid_Normal'),'GetItemCount')
        if countOk and type(count)=='number' and count<=300 then
            for n=1,count do
                local read,data=call(view,'GetItemData',n)
                if read and data~=nil then existing[#existing+1]=data end
            end
        end
        local rows,donor=merge_rows(existing,wardrobe,template)
        if not rows or #rows==0 then I.result('wardrobe',false,'skin_rows_unavailable');return end
        note('wardrobe_rows_error',nil)
        I.row_stage='set_native_item_list'
        assert(type(member(view,'SetInitItemList'))=='function','missing item-list setter')
        assert(type(member(view,'UpdateItemList'))=='function','missing item-list renderer')
        view:SetInitItemList(rows)
        view:UpdateItemList(rows)
        call(view,'ShowEmptyGunSkinList',false,true)
        views[view]={template=donor,rows=rows}
        refresh(view)
        I.row_stage='native_item_list_requested'
        note('wardrobe_rows_stage',I.row_stage)
        note('wardrobe_population_error',nil)
        note('wardrobe_group_count',#I.prepared)
        note('wardrobe_row_count',#rows)
        note('wardrobe_status','native_rows_requested_unverified')
        I.result('wardrobe',true,'native_rows_requested_unverified')
    end
    function I.install()
        local wardrobe=load('client.slua.logic.wardrobe.wardrobe_data')
        if wardrobe and not I.diagnostics.depot_hooks then
            local count=0
            for _,name in ipairs({'GetHallDepotItemDataByInsID','GetValidHallDepotItemDataByInsID'}) do
                local original=member(wardrobe,name)
                if type(original)=='function' and not depotHooked[name] then
                    wardrobe[name]=function(self,id,...)
                        if opt.enabled() and depot[tonumber(id)] then return depot[tonumber(id)] end
                        return original(self,id,...)
                    end
                    depotHooked[name]=true
                end
                if depotHooked[name] then count=count+1 end
            end
            I.diagnostics.depot_hooks=count==2
        end
        install_logic(wardrobe)
        -- ResolveBattleIcon is shared by inventory and nearby loot. Never
        -- replace it by weapon type: that loses the item instance and UI scope.
        I.diagnostics.global_icon_resolver_modified=false
        I.diagnostics.icon_scope='local_backpack_instances_only'
        if not I.diagnostics.backpack_hook then
            local cls=load('GameLua.Mod.BaseMod.Client.Backpack.BackPackItemUI')
            local original=member(cls,'UpdateItemTableData')
            local avatar=member(cls,'GetAvatarID')
            if type(avatar)=='function' then
                cls.GetAvatarID=function(self,data,...)
                    if opt.enabled() and member(self,'BackPackUI') then
                        if type(opt.observe_backpack)=='function' then pcall(opt.observe_backpack,member(self,'BackPackUI')) end
                        local ok,id=pcall(opt.skin_for_item,data)
                        if ok and id then return id end
                    end
                    return avatar(self,data,...)
                end
                I.diagnostics.backpack_avatar_getter=true
            end
            if type(original)=='function' then
                cls.UpdateItemTableData=function(self,data,...)
                    if opt.enabled() and member(self,'BackPackUI') then
                        if type(opt.observe_backpack)=='function' then pcall(opt.observe_backpack,member(self,'BackPackUI')) end
                        local ok,id=pcall(opt.skin_for_item,member(self,'ItemData'))
                        if ok and id then
                            local good,cfg=pcall(opt.item,id)
                            local icon=member(cfg,'ItemSmallIcon')
                            if good and type(icon)=='string' and icon~='' then
                                data=cfg
                                note('backpack_status','skin_icon_requested_unverified')
                            end
                        end
                    end
                    return original(self,data,...)
                end
                I.diagnostics.backpack_hook=true
            else I.diagnostics.backpack_status='native_backpack_class_unavailable' end
        end
        if not I.diagnostics.wardrobe_hook then
            local cls=load('client.slua.umg.Wardrobe.subtab_gun')
            local update=member(cls,'UpdateGunSkinList')
            local click=member(cls,'OnClickItem')
            local equipped=member(cls,'RefreshPutOnGunSkinListItem')
            if type(update)~='function' or type(click)~='function' or not wardrobe then
                I.diagnostics.wardrobe_status='native_wardrobe_class_unavailable';return
            end
            cls.UpdateGunSkinList=function(self,base,...)
                I.diagnostics.wardrobe_refresh_calls=(I.diagnostics.wardrobe_refresh_calls or 0)+1
                local result=table.pack(update(self,base,...))
                local ok,why=pcall(populate,self,base,wardrobe)
                if not ok then
                    note('wardrobe_rows_stage',I.row_stage)
                    note('wardrobe_population_error',error_text(why))
                    note('wardrobe_status','native_ui_population_failed')
                    I.result('wardrobe',false,'native_ui_population_failed')
                    -- Restore the stock view after a failed local population.
                    pcall(update,self,base,...)
                end
                return table.unpack(result,1,result.n)
            end
            cls.OnClickItem=function(self,widget,index,...)
                local grid=member(self,'LoopScrollGrid_Normal')
                local read,row=call(grid,'GetItemData',index)
                local fallback=views[self] and views[self].rows[index]
                if not read then row=fallback end
                local registered=depot[tonumber(member(row,'ins_id'))]
                if registered or (type(row)=='table' and row.__manhduathoi_local and opt.allowed[row_id(row)]) then
                    -- Always intercept our UI-only handles, including after stop
                    -- or a change to fashion/share mode. Never forward an ID.
                    if opt.enabled() and normal_mode() then
                        local ok,selected=pcall(opt.select,registered and registered.res_id or row.res_id)
                        if ok and selected then
                            pcall(refresh,self)
                            note('wardrobe_status','local_skin_selected')
                            if type(opt.preview)=='function' then
                                local called,requested,why=pcall(opt.preview,registered and registered.res_id or row.res_id)
                                note('lobby_preview_call_ok',called and requested==true)
                                note('lobby_preview_status',called and why or 'lobby_preview_error')
                            end
                        else note('wardrobe_status','local_selection_failed') end
                    end
                    return
                end
                return click(self,widget,index,...)
            end
            if type(equipped)=='function' then
                cls.RefreshPutOnGunSkinListItem=function(self,...)
                    local result=table.pack(equipped(self,...))
                    if opt.enabled() then pcall(refresh,self) end
                    return table.unpack(result,1,result.n)
                end
            end
            I.diagnostics.wardrobe_hook=true
        end
    end
    local bound=setmetatable({},{__mode='k'})
    function I.refresh_thumbnail(view)
        if not opt.enabled() or not normal_mode() then return false end
        local grid=member(view,'LoopScrollGrid_GunList')
        if grid then views[view]=views[view] or {} end
        local got,n=call(grid,'GetItemCount')
        if not got or type(n)~='number' or n<0 or n>128 then return false end
        local skin=opt.selected()
        for i=1,n do
            local read,row=call(grid,'GetItemData',i)
            if read and member(row,'resID')==opt.base and member(row,'skinResID')~=skin then
                row.skinResID=skin or 0
                call(grid,'RefreshItem',i,row)
                note('thumbnail_refreshes',(I.diagnostics.thumbnail_refreshes or 0)+1)
                return true
            end
        end
        return false
    end
    function I.refresh_thumbnails()
        for view in pairs(views) do pcall(I.refresh_thumbnail,view) end
    end
    function I.bind_view(view)
        if view==nil or not opt.enabled() or not normal_mode() then return false end
        local got,base=call(view,'GetCurrentShowGunID')
        if not got or base~=opt.base then return false end
        local visible,shown=call(view,'IsShow');if not visible or not shown then return false end
        views[view]=views[view] or {}
        if not bound[view] then
            local original=member(view,'OnClickItem')
            if type(original)~='function' then return false end
            local ok=pcall(function()
                view.OnClickItem=function(self,widget,index,...)
                    local read,row=call(member(self,'LoopScrollGrid_Normal'),'GetItemData',index)
                    local ins=read and instance_id(row)
                    if ins~=nil and selected_local(ins) then
                        call(self,'RefreshPutOnGunSkinListItem');pcall(refresh,self)
                        return
                    end
                    return original(self,widget,index,...)
                end
            end)
            if not ok then note('live_view_status','view_method_assignment_failed');return false end
            local render=member(view,'InitView')            if type(render)=='function' then
                view.InitView=function(self,node,row,...)
                    local localRow=member(row,'__manhduathoi_local') and opt.allowed[row_id(row)]
                    if localRow and opt.enabled() and normal_mode() then row.isUsing=row_id(row)==opt.selected() end
                    local result=table.pack(render(self,node,row,...))
                    if localRow and opt.enabled() and normal_mode() then
                        row.isUsing=row_id(row)==opt.selected()
                        call(node,'SetUsingState',row.isUsing)
                    end
                    return table.unpack(result,1,result.n)
                end
                note('live_badge_renderer_hook',true)
            end
            local currentSelect=member(view,'GetCurrentSelectItemInsID')
            if type(currentSelect)=='function' then
                view.GetCurrentSelectItemInsID=function(self,...)
                    local got,current=call(self,'GetCurrentShowGunID')
                    local skin=opt.selected()
                    if got and current==opt.base and opt.enabled() and normal_mode() and skin then return -skin end
                    return currentSelect(self,...)
                end
            end
            bound[view]=true
            call(member(view,'LoopScrollGrid_Normal'),'RefreshAllItems')
            note('live_view_bindings',(I.diagnostics.live_view_bindings or 0)+1)
        end
        pcall(refresh,view)
        pcall(I.refresh_thumbnail,view)
        note('live_view_status','active_wardrobe_instance_bound')
        return true
    end
    return I
end

    end)()
    local panel_factory=(function()
-- Project skin icons onto the LOCAL backpack weapon-detail panel only.
-- Its large weapon pictures do not use BackPackItemUI or CacheBattleItemMap.
-- Never changes shared ResolveBattleIcon, nearby loot or inventory records.
return function(opt)
    local B={diagnostics={requests=0,inventory_written=false,nearby_modified=false}}
    local images=setmetatable({},{__mode='k'})
    local registered=setmetatable({},{__mode='k'})
    local renderBound=setmetatable({},{__mode='k'})
    local scans=setmetatable({},{__mode='k'})
    local scanClock=0
    local invalidated=false
    local last
    local function member(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end);if ok then return v end;return nil
    end
    local function call(o,k,...)
        local fn=member(o,k);if type(fn)~='function' then return false end
        return pcall(fn,o,...)
    end
    local function visible(w)
        local got,value=call(w,'IsVisible')
        if got then return true,value==true end
        -- Optional custom blueprint method; not the native UWidget API.
        local old,v=call(w,'GetIsVisible');if old then return true,v==true end
        local read,state=call(w,'GetVisibility')
        if read and type(state)=='number' then return true,state~=1 and state~=2 end
        return false,false
    end
    local function children(w)
        local got,n=call(w,'GetChildrenCount');local result,seen={},{}
        local function add(c)
            if c~=w and opt.valid(c) and not seen[c] then result[#result+1]=c;seen[c]=true end
        end
        if got and type(n)=='number' and n>=0 and n<=4096 and n%1==0 then
            for i=0,n-1 do local ok,c=call(w,'GetChildAt',i);if ok then add(c) end end
        end
        local tree=member(w,'WidgetTree');add(member(tree,'RootWidget'))
        local list=member(tree,'AllWidgets');local counted,count=call(list,'Num')
        if counted and type(count)=='number' and count<=1024 then
            for i=0,count-1 do local read,c=call(list,'Get',i);if read then add(c) end end
        elseif type(list)=='table' then for _,c in ipairs(list) do add(c) end end
        return result
    end
    local function name(w)
        local ok,s=pcall(opt.name,w);return ok and type(s)=='string' and s or ''
    end
    function B.register(view)
        if view~=nil and not registered[view] then registered[view]=true;B.cached_widgets=nil end
    end
    function B.invalidate() invalidated=true end
    function B.bind_render(view)
        if type(view)~='table' or renderBound[view] then return end
        local class=view;local methods={};local classes={}
        for _=1,8 do
            if type(class)~='table' or classes[class] then break end
            classes[class]=true
            for key,value in next,class do
                if type(key)=='string' and type(value)=='function'
                    and (key:find('Weapon',1,true) or key:find('Gun',1,true))
                    and (key:find('Update',1,true) or key:find('Refresh',1,true)) then methods[key]=true end
            end
            class=member(getmetatable(class),'__index')
        end
        for key in pairs(methods) do
            local original=member(view,key)
            if type(original)=='function' then
                view[key]=function(self,...)
                    local result=table.pack(original(self,...))
                    -- Native render callbacks only invalidate discovery. Never
                    -- re-enter sync/load from a brush/layout callback.
                    invalidated=true
                    return table.unpack(result,1,result.n)
                end
                B.diagnostics.render_hooks=(B.diagnostics.render_hooks or 0)+1
            end
        end
        renderBound[view]=true
    end
    local function asset_key(path)
        if type(path)~='string' then return end
        return path:gsub("^[^']*'",''):gsub("'$",''):gsub('%.[^/%.]+$',''):lower()
    end
    local function brush_base(w)
        if type(opt.asset_path)~='function' then return end
        local resource=member(member(w,'Brush'),'ResourceObject')
        if resource==nil then return end
        local read,path=pcall(opt.asset_path,resource);local key=read and asset_key(path)
        if not key then return end
        for base in pairs(opt.names) do
            local cfg=opt.item(base)
            for _,field in ipairs({'ItemBigIcon','ItemSmallIcon'}) do
                if key==asset_key(member(cfg,field)) then return base end
            end
        end
        local state=images[w]
        if state and (state.pending or resource==state.resource) then return state.base end
    end
    local function weapon_label(w)
        local got,value=call(w,'GetText');if not got then return end
        local ok,s=pcall(opt.text,value);if not ok or type(s)~='string' then return end
        s=s:upper():gsub('^%s+',''):gsub('%s+$','')
        for base,label in pairs(opt.names) do
            if s==label or s:match('^'..label..'%s*:') then return base end
        end
    end
    local function scan(root)
        local job=scans[root]
        if not job or (not job.pending and scanClock-job.tick>=200) then
            job={tick=scanClock,queue={root},seen={[root]=true},index=1,
                labels={},label_widgets={},pictures={},pending=true}
            scans[root]=job
        end
        if not job.pending then
            local labels={}
            for _,w in ipairs(job.label_widgets) do
                if opt.valid(w) then local id=weapon_label(w);if id then labels[id]=true end end
            end
            job.labels=labels
            return job.labels,job.pictures,job.bounded,false
        end
        while job.index<=#job.queue and job.index<=4096 and B.work_remaining>0 do
            local w=job.queue[job.index];job.index=job.index+1
            B.work_remaining=B.work_remaining-1
            if opt.valid(w) then
                local label=weapon_label(w)
                if label then job.labels[label]=true;job.label_widgets[#job.label_widgets+1]=w end
                if type(member(w,'SetBrushFromPathAsync'))=='function' then
                    local mapped=brush_base(w)
                    local got,size=call(w,'GetDesiredSize')
                    local x,y=tonumber(member(size,'X')),tonumber(member(size,'Y'))
                    local key=name(w):lower()
                    local body=(key:find('weapon',1,true) or key:find('gun',1,true))
                        and not key:find('background',1,true) and not key:find('bg',1,true)
                        and not key:find('scope',1,true) and not key:find('frame',1,true)
                        and not key:find('border',1,true) and not key:find('slot',1,true)
                    if mapped or (got and x and y and x>=160 and y>=35 and x/y>=1.6 and x/y<=9)
                        or (body and (not x or x==0 or not y or y==0)) then
                        job.pictures[#job.pictures+1]={widget=w,name=name(w),width=x,height=y,base=mapped}
                    end
                end
                for _,c in ipairs(children(w)) do
                    if not job.seen[c] then job.seen[c]=true;job.queue[#job.queue+1]=c end
                end
            end
        end
        if job.index>#job.queue or job.index>4096 then
            job.pending=false;job.bounded=job.index>#job.queue
            job.tick=scanClock;job.queue=nil;job.seen=nil
        end
        return job.labels,job.pictures,not job.pending and job.bounded,job.pending
    end
    local function project(root,tick,selected,owned,seen,depth)
        if depth>16 or seen[root] then return 0 end
        seen[root]=true
        local labels,pictures,bounded,pending=scan(root)
        if pending then B.diagnostics.discovery_pending=true;return 0 end
        if not bounded then
            B.diagnostics.traversal_limit=true
            -- The main weapon grid is larger than one weapon card. Continue
            -- into bounded cards instead of rejecting the whole backpack.
            local found=0
            for _,c in ipairs(children(root)) do found=found+project(c,tick,selected,owned,seen,depth+1) end
            return found
        end
        if #pictures>1 then
            local named={}
            for _,p in ipairs(pictures) do
                local key=p.name:lower()
                if (key:find('weapon',1,true) or key:find('gun',1,true))
                    and not key:find('background',1,true) and not key:find('bg',1,true)
                    and not key:find('frame',1,true) and not key:find('border',1,true)
                    and (not p.width or p.width>0) and (not p.height or p.height>0) then
                    named[#named+1]=p
                end
            end
            if #named==1 then pictures=named end
        end
        local base,count=nil,0
        for id in pairs(labels) do base=id;count=count+1 end

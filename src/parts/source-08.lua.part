    local seed_slots={}
    for _,r in ipairs(seed_rows) do if r[8]=='cosmetic' then seed_slots[r[1]]=r[2] end end
    local avatar_context=avatar_context_factory({import=imported,valid=valid})
    local defaults={weapons=true,lobby=true,backpack=true,attachments=true,workshop=true,
        vehicles=true,killfeed=true,crates=true,cosmetics=true,emotes=true}
    local function cosmetic_slot(id)
        local cfg=table_item(id);local fn=member(imported('AvatarUtils'),'GetItemAvatarSlotID')
        if cfg and type(fn)=='function' then
            local ok,slot=pcall(fn,member(cfg,'ItemType'),id);if ok and slot and slot>0 then return slot end
        end
        return seed_slots[id] or (avatar_by_id[id] and avatar_by_id[id].slot)
    end
    state=state_factory({import=imported,defaults=defaults,
        weapon=function(base,id) return (byBase[base]~=nil and baseBySkin[id]==base)
            or (config.weapon_lookup and config.weapon_lookup[tostring(id)]==base) end,
        vehicle=function(base,id) return vehicleBaseByID[id]==base and base~=nil end,
        cosmetic=function(slot,id)
            local validSlots={[1]=true,[2]=true,[3]=true,[4]=true,[5]=true,[6]=true,[7]=true,
                [8]=true,[9]=true,[10]=true,[11]=true,[12]=true,[14]=true,[15]=true,[16]=true,[17]=true,[22]=true,[24]=true,[25]=true}
            local actual=cosmetic_slot(id)
            return validSlots[slot] and (actual==nil or actual==slot) and id>0 and id<=2147483647
        end,
        emote=function(slot,id)
            local cfg=table_item(id)
            return slot==1 and (cfg==nil or member(cfg,'ItemType')==22) and id>0 and id<=2147483647
        end})
    for base,id in pairs(state.weapons) do M.selected_ids[base]=id end
    state.weapons=M.selected_ids;M.features=state.toggles
    M.feature_state_diagnostics=state.diagnostics;M.selected_vehicle_ids=state.vehicles
    for _,vehicle in ipairs(config.vehicle_model_map or {}) do
        local base,id=vehicle.base_id,vehicle.test_skin_id
        if M.selected_vehicle_ids[base]==nil and vehicleBaseByID[id]==base then M.selected_vehicle_ids[base]=id end
    end
    if state.focus then M.target_base_id=state.focus;M.target_skin_id=M.selected_ids[state.focus] end
    local vehicle_dump=vehicle_dump_factory({import=imported,item=table_item,save=save_named})
    M.vehicle_dump_diagnostics=vehicle_dump.diagnostics
    local kills=kill_factory({enabled=function() return M.enabled end,
        tick=function() return M.total_ticks end,
        require=require,controller=function() return M.controller end,
        announcement_enabled=function() return M.features.killfeed end,
        crate_enabled=function() return M.features.crates end,
        local_controller=local_controller,valid=valid,
        base=function(id) return baseBySkin[id] or (byBase[id] and id) end,
        selected=function(base) return M.selected_ids[base] end,
        weapon=function(base)
            for w in pairs(equipped) do
                local got,id=method(w,'GetWeaponID')
                if got and id==base and applied[w]==M.selected_ids[base] then return w end
            end
        end,
        tomb=function(world,victim)
            local fn=member(imported('PropsUtils'),'GetPlayerTombBoxByPlayerKey')
            if type(fn)=='function' then return fn(world,victim) end
        end,
        box_path=function(skin)
            local fn=member(imported('AvatarUtils'),'GetWeaponAvatarDeadBoxAvatarHandlePath')
            if type(fn)=='function' then return fn(skin) end
        end})
    M.kill_diagnostics=kills.diagnostics
    kills.hook_class(controller_class)
    local function in_lobby()
        local fn=member(GameStatus,'IsInLobbyOrMainCity')
        if type(fn)=='function' then local ok,value=pcall(fn);if ok then return value==true end end
        local ok,pawn=method(M.controller,'GetCurPawn')
        return ok and not valid(pawn)
    end
    local lobby=lobby_factory({require=require,controller=function() return M.controller end,
        local_controller=local_controller,valid=valid,in_lobby=in_lobby,
        base_for_skin=function(id) return baseBySkin[id] end,
        uid=function() return member(member(DataMgr,'roleData'),'uid') end})
    M.lobby_preview=lobby.diagnostics
    local function attachment_signature(w)
        backpack_utils=backpack_utils or imported('BackpackUtils')
        local getter=member(backpack_utils,'GetWeaponAttachByWeaponDefineID')
        local idOk,id=method(w,'GetItemDefineID')
        local bpOk,bp=method(M.controller,'GetBackpackComponent')
        if type(getter)~='function' or not idOk or not bpOk or not valid(bp) then return nil end
        local got,items=pcall(getter,id,bp)
        if not got or items==nil then return nil end
        local counted,n=method(items,'Num')
        if not counted and type(items)=='table' then n=rawlen(items) end
        if type(n)~='number' or n<0 or n>32 or n%1~=0 then return nil end
        local result,units={},{}
        for i=1,n do
            local item
            if counted then local read,value=method(items,'Get',i-1);if read then item=value end
            else item=member(items,i) end
            local define=member(item,'DefineID')
            local typeID,socket=member(define,'TypeSpecificID'),member(item,'Socket')
            if type(typeID)~='number' or type(socket)~='number' then return nil end
            local parent=member(imported('AvatarUtils'),'GetWeaponAttachmentSkinParentID')
            if type(parent)=='function' then
                local read,value=pcall(parent,typeID)
                if read and type(value)=='number' and value>0 then typeID=value end
            end
            result[#result+1]=tostring(socket)..':'..tostring(typeID)
            units[#units+1]={type_id=typeID,socket=socket}
        end
        table.sort(result);return table.concat(result,'|'),units
    end
    local function skin_for_item(data)
        if not M.enabled or not local_controller(M.controller) or data==nil then return nil end
        local define=member(data,'DefineID')
        if slua and type(slua.IndexReference)=='function' then
            local ok,result=pcall(slua.IndexReference,data,'DefineID');if ok then define=result end
        end
        local base=member(define,'TypeSpecificID')
        if not byBase[base] then return nil end
        local same=member(backpack_utils,'IsSameInstance')
        if type(same)~='function' then return nil end
        for w,skin in pairs(applied) do
            local ctx={weapon=w,is_valid=valid}
            local snapshot=Weapon.inspect(ctx,base)
            if equipped[w] and skin==M.selected_ids[base] and snapshot.slot_skin_id==skin then
                local ok,id=method(w,'GetItemDefineID')
                if ok then
                    local checked,matches=pcall(same,id,define)
                    if checked and matches==true then return skin end
                end
            end
        end
    end
    local function notice(message)
        if type(ShowNotice)~='function' then return false end
        local ok=pcall(ShowNotice,message);return ok
    end
    local panel
    local access=ui_access_factory({manager=function() return UIManager end})
    M.ui_access_diagnostics=access.diagnostics
    local function create_weapon_ui(base,entry)
        M.uis[base]=ui_factory({require=require,base=base,name=entry.name,ids=entry.ids,allowed=entry.allowed,
            upgrade_only=config.upgrade_only==true,
            enabled=function() return M.enabled end,selected=function() return M.selected_ids[base] end,
            select=function(id) return M.choose_skin(id,base) end,
            item=table_item,upgrade_manager=upgrade_manager,skin_for_item=skin_for_item,
            observe_backpack=function(view) if panel then panel.register(view) end end,
            preview=function(id)
                if M.features.lobby then return lobby.preview(id,base) end
                return false,'lobby_toggle_off'
            end,notice=notice,
            prepared=function(groups)
                if config.upgrade_only and M.enabled and not M.uis[base].by_skin[M.selected_ids[base]] then
                    local prior=M.selected_ids[base]
                    M.choose_skin((M.uis[base].max_by_id and M.uis[base].max_by_id[prior]) or groups[1].id,base,false)
                end
            end,
            changed=function() report('native_ui_updated',true,true) end})
    end
    for base,entry in pairs(byBase) do create_weapon_ui(base,entry) end
    M.ui=M.uis[config.trial_base_id]
    local function group_for_skin(id)
        local base=baseBySkin[id];local ui=base and M.uis[base]
        return ui and ui.by_skin and ui.by_skin[id]
    end
    local function weapon_ads(w)
            if member(member(w,'WeaponAvatarComponent'),'IsScopeIn')==true then return true end
            local got,value=method(w,'IsOwnerInGunADS')
            if got and type(value)=='boolean' then return value end
            local got,pawn=method(M.controller,'GetCurPawn')
            if got and valid(pawn) then
                local read,value=method(pawn,'GetIsGunADS')
                if not read then read,value=method(pawn,'IsGunADS') end
                if read then return value==true end
                return member(pawn,'bIsOpenWeaponSight')==true
            end
            return false
    end
    local parts=parts_factory({valid=valid,group=group_for_skin,upgrade_manager=upgrade_manager,
        tick=function() return M.total_ticks end,
        handle_key=function(handle)
            if type(engine_asset_path)=='function' then return engine_asset_path(handle) end
        end,
        ads=weapon_ads,
        preload=function(id,skin)
            local base=baseBySkin[skin]
            if base and byBase[base] then return byBase[base].resources.preload_handle(id) end
        end,
        defaults=function(skin)
            local fn=member(imported('AvatarUtils'),'GetWeaponAvatarDefaultAttachmentSkin')
            if type(fn)~='function' then return nil end
            for _,out in ipairs({false,true}) do
                local r
                if out then r=table.pack(pcall(fn,skin,false,nil)) else r=table.pack(pcall(fn,skin,false)) end
                if r[1] then
                    for i=2,r.n do if type(r[i])=='table' or type(r[i])=='userdata' then return r[i] end end
                end
            end
        end,
        parent=function(id)
            local cls=imported('AvatarUtils');local fn=member(cls,'GetWeaponAttachmentSkinParentID')
            if type(fn)=='function' then return fn(id) end
        end})
    M.attachment_diagnostics=parts.diagnostics
    M.preload_skin=function(base,id)
        if M.features.attachments then return parts.preload(nil,id) end
    end
    local function sync_parts(...)
        if not M.features.attachments then return true,'attachments_toggle_off' end
        local called,ok,why=pcall(parts.sync,...)
        if not called then
            parts.diagnostics.status='attachment_adapter_error'
            parts.diagnostics.last_error=tostring(ok):sub(1,480)
            return false,parts.diagnostics.status
        end
        return ok,why
    end
    local workshop=workshop_factory({require=require,enabled=function() return M.enabled and M.features.workshop end,
        depot=function()
            local got,value=pcall(require,'client.slua.logic.wardrobe.wardrobe_data');if got then return value end
        end,
        group_for_id=function(id)
            local base=baseBySkin[id];local ui=base and M.uis[base]
            return ui and ui.by_skin and ui.by_skin[(ui.max_by_id and ui.max_by_id[id]) or id]
        end,
        current_state=function(id)
            local got,value=method(upgrade_manager(),'GetCurrentStateItemID',id);if got then return value end
        end,
        item=table_item,notice=notice,select=function(id,base)
            local ok=M.choose_skin(id,base)
            if ok and M.features.lobby then lobby.preview(id,base) end
            return ok
        end,
        current=function() return M.selected_ids[M.target_base_id] end,
        representative=function(id)
            local base=baseBySkin[id];local ui=base and M.uis[base]
            return ui and ui.max_by_id and ui.max_by_id[id]
        end,
        groups=function()
            local groups={}
            for _,ui in pairs(M.uis) do
                if ui.by_group then for id,g in pairs(ui.by_group) do groups[id]=g end end
            end
            return groups
        end,
        record=function(id)
            local base=baseBySkin[id];local ui=base and M.uis[base]
            return ui and ui.record_for_skin(id)
        end})
    M.workshop_diagnostics=workshop.diagnostics
    local names={};for base,e in pairs(byBase) do names[base]=e.name end
    local all_upgrades=upgrade_catalog_factory({manager=upgrade_manager,item=table_item,
        base=function(id)
            local fn=member(backpack_utils,'GetWeaponIDBySkinID')
            if type(fn)=='function' then
                local ok,base=pcall(fn,M.controller,id);if ok and type(base)=='number' and base>0 then return base end
            end
            return baseBySkin[id] or (config.weapon_lookup and config.weapon_lookup[tostring(id)])
        end,
        is_gun=function(itemType)
            local fn=member(backpack_utils,'IsGunItemType')
            if type(fn)=='function' then local ok,v=pcall(fn,itemType);return ok and v==true end
            return false
        end,
        name=function(base,cfg)
            if byBase[base] then return byBase[base].name end
            local title=member(cfg,'ItemName')
            if type(title)=='number' and type(member(LocUtil,'GetLocalizeResStr'))=='function' then
                local ok,text=pcall(LocUtil.GetLocalizeResStr,title);if ok and type(text)=='string' then title=text end
            end
            return type(title)=='string' and title~='' and title or tostring(base)
        end,
        add=function(row)
            local base=row.base_id;local entry=byBase[base]
            if not entry then
                entry={base=base,name=row.name,ids={},allowed={},resources=resource_factory(import,require)}
                byBase[base]=entry;names[base]=row.name
            end
            for _,id in ipairs(row.skin_ids) do
                if not entry.allowed[id] then entry.ids[#entry.ids+1]=id;entry.allowed[id]=true end
                baseBySkin[id]=base;allowed[id]=true
                local key='weapon:'..base;M.core.catalog[key]=M.core.catalog[key] or {}
                M.core.catalog[key][id]={kind='weapon',base_id=base,skin_id=id}
            end
            if not M.uis[base] then create_weapon_ui(base,entry) end
            local ui=M.uis[base];ui.prepared=nil
            if M.enabled then pcall(ui.prepare);pcall(ui.install) end
            M.cosmetic_forbidden_types=nil
        end})
    M.upgrade_catalog=all_upgrades.diagnostics
    local animated=animated_factory({import=imported,valid=valid,tick=function() return M.total_ticks end,
        weapon=function(base,skin)
            for w in pairs(equipped) do
                local got,id=method(w,'GetWeaponID')
                if got and id==base and applied[w]==skin then return w end
            end
        end})
    panel=panel_factory({valid=valid,local_controller=local_controller,names=names,item=table_item,
        render_preview=animated.render,finish_preview=animated.finish,clear_preview=animated.clear,
        views=access.backpack_views,
        prepare_icon=function(id,base,image)
            local got,util=pcall(require,'client.common.ui_util');if not got then return false end
            local cfg,default=table_item(id),table_item(base)
            local big=member(cfg,'ItemBigIcon')
            local name=type(big)=='string' and big~='' and big~=member(default,'ItemBigIcon')
                and 'GetItemBigIcon' or 'GetItemSmallIcon'
            local fn=member(util,name);if type(fn)~='function' then return false end
            fn(id,image,true);return true
        end,
        asset_path=function(o) if type(engine_asset_path)=='function' then return engine_asset_path(o) end end,
        name=function(o) if type(engine_object_name)=='function' then return engine_object_name(o) end end,
        text=function(value)
            if type(value)=='string' then return value end
            local cls=imported('KismetTextLibrary');local fn=member(cls,'Conv_TextToString')
            if type(fn)=='function' then return fn(value) end
        end,
        widgets=function(world)
            local cls=imported('WidgetBlueprintLibrary');local fn=member(cls,'GetAllWidgetsOfClass')
            local widgetClass=imported('UserWidget')
            if type(fn)~='function' or widgetClass==nil then return nil end
            local result=table.pack(fn(world,widgetClass,false))
            for i=1,result.n do
                local value=result[i]
                if type(member(value,'Num'))=='function' and type(member(value,'Get'))=='function' then return value end
                if type(value)=='table' and member(value,1)~=nil then return value end
            end
        end})
    M.backpack_display=panel.diagnostics
    M.backpack_display.animation=animated.diagnostics
    local premium=vehicle_catalog_factory({item=table_item,
        multi=function(id)
            if CDataTable and type(CDataTable.GetTableData)=='function' then
                local got,value=pcall(CDataTable.GetTableData,'MultiLevelItem',id);if got then return value end
            end
        end,
        group=function(id)
            if CDataTable and type(CDataTable.GetTableByFilter)=='function' then

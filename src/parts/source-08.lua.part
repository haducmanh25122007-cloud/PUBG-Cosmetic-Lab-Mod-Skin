            end
        end})
    local vehicles=vehicle_factory({rows=config.vehicle_catalog or {},require=require,valid=valid,item=table_item,
        in_lobby=in_lobby,
        changed=function() if M.sync_vehicle_state then M.sync_vehicle_state() end end,
        tick=function() return M.total_ticks end,
        filter=function(rows) return premium.filter(rows) end,
        enabled=function() return M.enabled and M.features.vehicles end,
        selected=function(base) return M.selected_vehicle_ids[base] end,
        choose=function(base,id)
            if not M.enabled or vehicleBaseByID[id]~=base then return false end
            M.selected_vehicle_ids[base]=id;state.save();report('vehicle_selection_changed',true,true);return true
        end,
        base=function(id)
            local fn=member(imported('AvatarUtils'),'GetVehicleDefaultID')
            if type(fn)=='function' then local got,value=pcall(fn,id);if got then return value end end
        end,
        new_avatar=function(id)
            local fn=member(imported('AvatarUtils'),'IsVehicleAvatarNewPorperty')
            if type(fn)=='function' then local got,value=pcall(fn,id);if got then return value end end
        end})
    M.vehicle_diagnostics=vehicles.diagnostics
    M.vehicle_diagnostics.premium_filter=premium.diagnostics
    local projection=projection_factory({import=imported,local_controller=local_controller,
        weapons=function() return M.enabled and M.features.weapons end,
        vehicles=function() return M.enabled and M.features.vehicles end,
        selected_weapons=function() return M.selected_ids end,
        vehicle_lists=vehicles.lists,selected_vehicle=function(base) return M.selected_vehicle_ids[base] end,
        vehicle_style_keys=function(base)
            local result={}
            local actual=M.vehicle_diagnostics.mounted_default_id
            if M.vehicle_diagnostics.mounted_base_id==base and actual and actual~=base then result[1]=actual end
            return result
        end})
    M.controller_projection=projection.diagnostics
    local collection=collection_factory({enabled=function() return M.enabled and M.features.vehicles and M.features.workshop end,
        views=access.instances,
        name=function(o) if type(engine_object_name)=='function' then return engine_object_name(o) end end,
        module=function()
            local cfg=member(ModuleManager,'LobbyModuleConfig');local get=member(ModuleManager,'GetModule')
            local key=member(cfg,'VehicleCollectSystem')
            if key~=nil and type(get)=='function' then local ok,value=pcall(get,key);if ok then return value end end
        end})
    M.vehicle_collection=collection.diagnostics
    M.vehicle_skin_rows=vehicles.rows
    M.select_vehicle_skin=vehicles.select
    function M.sync_vehicle_state()
        projection.sync(M.controller)
        local ok,pawn=method(M.controller,'GetCurPlayerCharacter')
        if not ok or not valid(pawn) then ok,pawn=method(M.controller,'GetCurPawn') end
        if ok and valid(pawn) then vehicles.step(pawn,M.controller) end
    end
    local cosmetic_ready_tick=math.huge
    local cosmetic_weapons_ready=false
    local refinement=refinement_factory({require=require,item=table_item,options=config.cosmetic_options,
        tick=function() return M.total_ticks end,clock=type(os)=='table' and os.clock or nil,
        manager=upgrade_manager,avatar=function(id) return avatar_by_id[id] end,
        table_row=function(name,id)
            local get=member(CDataTable,'GetTableData')
            if type(get)=='function' then return get(name,id) end
        end})
    local cosmetics=cosmetic_factory({refinement=refinement,presentation_factory=presentation_factory,import=imported,require=require,item=table_item,valid=valid,
        seed=seed_rows,options=config.cosmetic_options,manager=upgrade_manager,
        normal_source=function() return member(EWardrobeDataSource,'Wardrobe') end,
        avatar=function(id) return avatar_by_id[id] end,avatar_ids=avatar_ids,
        clock=type(os)=='table' and os.clock or nil,
        in_lobby=in_lobby,
        ready=function()
            return in_lobby() or not M.features.weapons or M.total_ticks>=cosmetic_ready_tick
        end,
        xsuits=function()
            local fn=member(CDataTable,'GetTable')
            if type(fn)=='function' then return fn('GoldenSuitUpgradeCfg') end
        end,
        extra_records=function()
            local rows={}
            if M.enabled and M.features.vehicles then
                for base in pairs(vehicles.lists()) do
                    for _,row in ipairs(vehicles.rows(base)) do rows[#rows+1]=row end
                end
            end
            if M.enabled and M.features.weapons then
                for _,ui in pairs(M.uis) do
                    for _,g in ipairs(ui.prepared or {}) do
                        local row=ui.record_for_skin(g.id);if row then rows[#rows+1]=row end
                    end
                end
            end
            return rows
        end,
        forbidden_type=function(itemType)
            if M.cosmetic_forbidden_types==nil then
                local blocked={};local bases={}
                for base in pairs(byBase) do bases[base]=true end
                -- Raw refit rows also include parachutes (e.g. 703001).
                -- Only validated vehicle groups may exclude an ItemType.
                for base in pairs(vehicles.lists()) do bases[base]=true end
                for base in pairs(bases) do
                    local value=member(table_item(base),'ItemType');if value then blocked[value]=true end
                end
                local get=member(imported('AvatarUtils'),'GetWeaponAttachments')
                if type(get)=='function' then
                    for base in pairs(byBase) do
                        local ok,ids=pcall(get,base,false)
                        local counted,n=method(ids,'Num')
                        if ok and counted and type(n)=='number' and n<=64 then
                            for i=0,n-1 do
                                local read,id=method(ids,'Get',i)
                                local value=read and member(table_item(id),'ItemType')
                                if value then blocked[value]=true end
                            end
                        end
                    end
                end
                M.cosmetic_forbidden_types=blocked
                if M.cosmetic_diagnostics then M.cosmetic_diagnostics.excluded_item_types=blocked end
            end
            return M.cosmetic_forbidden_types[itemType]==true
        end,
        tick=function() return M.total_ticks end,
        enabled=function(kind) return M.enabled and M.features[kind=='emote' and 'emotes' or 'cosmetics'] end,
        selected=function(kind,slot) return (kind=='emote' and state.emotes or state.cosmetics)[slot] end,
        selections=function(kind) return kind=='emote' and state.emotes or state.cosmetics end,
        choose=function(kind,slot,id)
            local selected=kind=='emote' and state.emotes or state.cosmetics;selected[slot]=id
            state.save();return true
        end,
        context=function()
            local got,pawn=method(M.controller,'GetCurPlayerCharacter')
            if not got or not valid(pawn) then got,pawn=method(M.controller,'GetCurPawn') end
            local model=pawn
            if in_lobby() then
                local loaded,team=pcall(require,'client.logic.avatar.logic_team_avatar_manager')
                local get=loaded and member(team,'GetAvatarByUid')
                if type(get)=='function' then
                    local ok,avatar=pcall(get,member(member(DataMgr,'roleData'),'uid'))
                    local ready,value=method(ok and avatar or nil,'GetModel');if ready then model=value end
                end
            end
            if not valid(model) then return end
            return avatar_context.resolve(model)
        end})
    M.cosmetic_diagnostics=cosmetics.diagnostics
    M.avatar_context_diagnostics=avatar_context.diagnostics
    M.config=config
    M.build_label=config.build_label
    local character_slots={head=1,hair=2,hat=3,face=4,clothes=5,pants=6,shoes=7,
        backpack=8,helmet=9,armor=10,parachute=11,glasses=12,glider=15,
        hand_effect=16,backpack_pendant=17,foot_effect=22}
    for key,id in pairs(config.character_skins or {}) do
        local slot=character_slots[key] or tonumber(key)
        if slot and type(id)=='number' and id>0 then
            local kind,actual=cosmetics.classify(id)
            if kind=='cosmetic' and actual==slot then state.cosmetics[slot]=id end
        end
    end
    M.cosmetic_rows=cosmetics.rows;M.select_cosmetic=cosmetics.select;M.play_emote=cosmetics.play
    function M.set_feature(key,value)
        if defaults[key]==nil or type(value)~='boolean' then return false,'invalid_feature' end
        if M.features[key]==value then return true,'unchanged' end
        M.features[key]=value
        if not value then
            if key=='attachments' then parts.clear()
            elseif key=='backpack' then panel.clear()
            elseif key=='lobby' then lobby.clear()
            elseif key=='vehicles' then vehicles.clear()
            elseif key=='cosmetics' then cosmetics.clear()
            elseif key=='emotes' then cosmetics.stop_emote()
            elseif key=='weapons' then
                for w in pairs(equipped) do
                    local got,base=method(w,'GetWeaponID')
                    if got and byBase[base] then
                        local ctx={weapon=w,is_valid=valid}
                        pcall(Weapon.apply,ctx,{base_id=base,skin_id=base})
                        pcall(Weapon.reload_equipped,ctx,{base_id=base,skin_id=base})
                        attempted[w]=nil;applied[w]=nil;loaded_assets[w]=nil;pending_force[w]=nil
                    end
                end
            end
        elseif key=='lobby' and M.selected_ids[M.target_base_id] then
            lobby.preview(M.selected_ids[M.target_base_id],M.target_base_id)
        end
        if key=='workshop' and workshop.invalidate then workshop.invalidate() end
        if (key=='cosmetics' or key=='emotes') and cosmetics.invalidate then cosmetics.invalidate() end
        local saved=state.save();report('feature_toggle_changed',true,true)
        return true,saved and 'saved_verified' or 'session_only_readback_failed'
    end
    M.custom_menu={location='native_settings_only',floating_ui=false,vehicle_picker='native_wardrobe_only'}
    local settings=settings_factory({require=require,localize=function() return LocUtil end,
        changed=function() report('native_settings_controls_created_unverified','flush',true) end,
        defer=function(fn) return method(M.controller,'AddGameTimer',0.05,false,fn) end,
        panel_key=function(panel)
            if valid(panel) and type(engine_asset_path)=='function' then return engine_asset_path(panel) end
        end,
        manager=function() return UIManager end,
        get=function(key) if key=='master' then return M.enabled end;return M.features[key] end,
        set=function(key,value)
            if key=='master' then
                if type(value)~='boolean' then return false,'invalid_master_toggle' end
                if value then return M.start() end
                M.stop();return true
            end
            return M.set_feature(key,value)
        end})
    M.settings_diagnostics=settings.diagnostics
    local wardrobe_seen
    local function sync_live_ui()
        pcall(access.install)
        pcall(settings.sync)
        pcall(collection.sync)
        pcall(vehicles.bind_controller,M.controller)
        local projected,projectionError=pcall(projection.sync,M.controller)
        if not projected then projection.diagnostics.last_error=tostring(projectionError):sub(1,480) end
        local view,parent=access.wardrobe()
        local shown,value=method(parent,'IsShow')
        if shown and value~=true then view=nil end
        local gunView=type(member(view,'GetCurrentShowGunID'))=='function'
        if view and gunView then
            if wardrobe_seen~=view then
                wardrobe_seen=view
                M.wardrobe_base_seen=nil
            end
            for _,ui in pairs(M.uis) do
                pcall(ui.bind_view,view)
                pcall(ui.refresh_thumbnail,view)
            end
            local got,current=method(view,'GetCurrentShowGunID')
            if got and byBase[current] and M.selected_ids[current]
                and M.wardrobe_base_seen~=current then
                M.wardrobe_base_seen=current
                local saved=M.selected_ids[current]
                M.choose_skin(saved,current,true)
                if M.features.lobby then lobby.preview(saved,current) end
            end
        else wardrobe_seen=nil;M.wardrobe_base_seen=nil end
        if view and not gunView then
            pcall(vehicles.bind,view);pcall(cosmetics.bind_view,view,parent)
            pcall(cosmetics.refresh_view,view,parent)
        end
        local upgrade=access.workshop()
        if upgrade then
            local ok,err=pcall(workshop.sync,upgrade)
            if not ok then workshop.diagnostics.status='workshop_live_adapter_error';workshop.diagnostics.last_error=tostring(err):sub(1,480) end
        end
    end
    local function defer(c,delay,fn,bootstrap)
        if c==nil or (not bootstrap and not local_controller(c)) then return false end
        local ok=method(c,'AddGameTimer',delay,false,function()
            local good=pcall(fn)
            if not good then M.enabled=false;report('runtime_callback_error') end
        end)
        return ok
    end
    local function process_weapon(w)
        local id_ok,base=method(w,'GetWeaponID')
        if not id_ok or not byBase[base] then return end
        local target=M.selected_ids[base]
        if not target then report('upgrade_skin_selection_not_ready');return end
        local resources=byBase[base].resources
        local ctx={weapon=w,is_valid=valid,asset_path=engine_asset_path}
        local current,reason=Weapon.current(ctx,base)
        if type(current)~='number' then report(reason or 'weapon_bridge_not_ready');return end
        local snapshot=Weapon.inspect(ctx,base)
        local signature,attachmentUnits=attachment_signature(w)
        local assetParts={}
        for _,key in ipairs({'entity_staticmesh_asset','entity_skeletalmesh_asset'}) do
            if type(snapshot[key])=='string' then assetParts[#assetParts+1]=snapshot[key] end
        end
        if #assetParts==0 then
            for _,key in ipairs({'weapon_staticmesh_asset','weapon_skeletalmesh_asset'}) do
                if type(snapshot[key])=='string' then assetParts[#assetParts+1]=snapshot[key] end
            end
        end
        local assetKey=#assetParts>0 and table.concat(assetParts,'|') or nil
        snapshot.master_asset_key=assetKey
        if assetKey and (snapshot.entity_skin_id==base or
            (snapshot.entity_skin_id~=target and snapshot.slot_skin_id~=target and current==base)) then
            stock_assets[w]=assetKey
        end
        snapshot.stock_master_asset_key=stock_assets[w]
        local stockPath=assetKey and assetKey:find('/Weapon/MainWeapon/Rifle/'..byBase[base].name..'/',1,true)~=nil
        snapshot.master_mesh_default=stockPath or (assetKey~=nil and stock_assets[w]~=nil and assetKey==stock_assets[w])
        if stockPath and not stock_assets[w] then stock_assets[w]=assetKey;snapshot.stock_master_asset_key=assetKey end
        if M.features.attachments then pcall(parts.preload,w,target) end
        local masterLoaded=snapshot.slot_skin_id==target and snapshot.entity_skin_id==target
            and not snapshot.master_mesh_default
            and snapshot.mesh_valid and (snapshot.all_mesh_loaded==true
                or (assetKey~=nil and loaded_assets[w]==assetKey))
        local recovering,recoveryReason
        if pending_force[w] then recovering=true;recoveryReason=pending_force[w]
        else
            recovering,recoveryReason=recovery.observe(w,M.total_ticks,target,current,
                snapshot,signature,member(w,'WeaponAvatarComponent'))
        end
        -- A freshly picked-up weapon can inherit the correct cached SkinID
        -- before its stock mesh is replaced. Do not treat that ID as success.
        if not attempted[w] and current==target and snapshot.master_mesh_default then
            recovering=true;recoveryReason='weapon_default_mesh_after_pickup'
        end
        if recovering and recoveryReason=='weapon_attachments_changed' and masterLoaded then
            local ok,why=sync_parts(w,base,target,attachmentUnits,false)
            if ok then
                pending_force[w]=nil;parts.avoided_reload()
                M.weapon_observation={latest=snapshot,recovery_reason=recoveryReason,attachment_status=why}
                M.last_weapon_status='attachment_only_update_no_master_reload'
                report(M.last_weapon_status);return
            end
        end
        local scoped=weapon_ads(w)
        if scoped and (recovering or not masterLoaded) then
            M.last_weapon_status='weapon_change_deferred_while_ads';report(M.last_weapon_status);return
        end
        if recovering then
            -- A previous success is not permanent: attachments can recreate
            -- the mesh/component or restore the original equipped definition.
            attempted[w]=nil;applied[w]=nil
            pending_force[w]=recoveryReason
            M.weapon_observation={before=snapshot,recovery_reason=recoveryReason}
        elseif recoveryReason=='weapon_recovery_limit' then
            M.last_weapon_status=recoveryReason;report(recoveryReason);return
        end
        if masterLoaded and not recovering and not recoveryReason then
            loaded_assets[w]=assetKey
            local attempt=attempted[w]
            local ok=sync_parts(w,base,target,attachmentUnits,attempt and attempt.parts_need_refresh==true)
            if ok and attempt then attempt.parts_need_refresh=false end
        end
        if attempted[w] then M.weapon_observation=attempted[w].observation end
        local function observed(status,force)
            M.last_weapon_status=status
            M.weapon_observation=M.weapon_observation or {}
            M.weapon_observation.latest=snapshot
            report(status,force)
        end
        local function sync_loaded_cache()
            if snapshot.slot_skin_id~=target or snapshot.entity_skin_id~=target
                or not snapshot.mesh_valid or snapshot.all_mesh_loaded~=true then return false end
            local attempt=attempted[w]
            if not attempt then
                attempt={status='native_id_matches_check_visuals',age=0,accepted=true,
                    observation={before=snapshot}}                attempted[w]=attempt;M.weapon_observation=attempt.observation
            end
            if attempt.cache_attempted then return false end
            attempt.cache_attempted=true
            local _,why,details=Weapon.sync_local_skin_cache(ctx,{base_id=base,skin_id=target})
            M.weapon_observation.skin_cache_status=why
            M.weapon_observation.skin_cache_details=details
            snapshot=Weapon.inspect(ctx,base)
            observed(why,true);return true
        end
        local recoveryAttempt=attempted[w]
        if recoveryAttempt and recoveryAttempt.recovery and recoveryAttempt.accepted
            and not recoveryAttempt.reload_attempted
            and M.total_ticks>=(recoveryAttempt.force_reload_tick or 0)
            and snapshot.slot_skin_id==target then
            if scoped then observed('weapon_reload_deferred_while_ads');return end
            -- With attachments, main ID may remain correct while its mesh was
            -- rebuilt from the stock definition. Reload before the ID shortcut.
            recoveryAttempt.reload_attempted=true
            M.weapon_observation.before_reload=snapshot
            local requested,why,details=Weapon.reload_equipped(ctx,{base_id=base,skin_id=target})
            M.weapon_observation.reload_status=why
            M.weapon_observation.reload_details=details
            if requested then M.reload_calls=M.reload_calls+1;recoveryAttempt.parts_need_refresh=true end
            snapshot=Weapon.inspect(ctx,base)
            M.weapon_observation.after_reload=snapshot
            observed(why,true);return
        end
        if current==target and not recovering and not snapshot.master_mesh_default then
            applied[w]=target
            if sync_loaded_cache() then return end
            observed('native_id_matches_check_visuals');return
        end
        if not attempted[w] then
            M.resource=resources.inspect(target)
            if M.resource.handle_exists==false then
                if not resources.download_attempted then
                    local _,why=resources.request_download(target)
                    M.download_status=why
                end
                observed('battle_skin_resource_missing');return
            end
            M.weapon_observation=M.weapon_observation or {before=snapshot}
            if not recovering then M.weapon_observation={before=snapshot} end
            local result
            if recovering then
                local accepted,why=Weapon.apply(ctx,{base_id=base,skin_id=target})
                result={status=accepted and 'awaiting_confirmation' or (why or 'apply_failed')}
                pending_force[w]=nil
            else result=M.core:on_ready('weapon',base,ctx) end
            M.apply_calls=M.apply_calls+1
            attempted[w]={status=result.status,age=0,observation=M.weapon_observation,
                recovery=recovering==true,
                parts_need_refresh=recovering==true,
                force_reload_tick=recovering and M.total_ticks+(config.reload_after_ticks or 1) or nil,
                accepted=result.status=='awaiting_confirmation'
                or result.status=='id_confirmed_visual_unverified'}
            snapshot=Weapon.inspect(ctx,base)
            M.weapon_observation.after_apply=snapshot
            observed(result.status,true);return
        end
        local attempt=attempted[w]
        attempt.age=attempt.age+1
        if not attempt.accepted then observed(attempt.status);return end
        -- One bounded refresh, only after the engine confirms the selected slot.
        -- Check this before the 'slot loaded' early return: v0.4 skipped reload
        -- for the exact device state where slot/entity matched but main ID did not.
        if attempt.age>=(config.reload_after_ticks or 1) and not attempt.reload_attempted and snapshot.slot_skin_id==target then
            if scoped then observed('weapon_reload_deferred_while_ads');return end
            attempt.reload_attempted=true
            M.weapon_observation.before_reload=snapshot
            local requested,why,details=Weapon.reload_equipped(ctx,{base_id=base,skin_id=target})
            M.weapon_observation.reload_status=why
            M.weapon_observation.reload_details=details
            if requested then M.reload_calls=M.reload_calls+1;attempt.parts_need_refresh=true end
            snapshot=Weapon.inspect(ctx,base)
            M.weapon_observation.after_reload=snapshot
            observed(why,true);return
        end
        if snapshot.slot_skin_id==target and snapshot.entity_skin_id==target
            and snapshot.mesh_valid and snapshot.all_mesh_loaded==true then
            applied[w]=target
            if sync_loaded_cache() then return end
            observed('target_slot_loaded_check_visuals');return
        end
        if attempt.age>=30 then
            observed(snapshot.slot_skin_id==target and 'target_slot_mesh_unconfirmed'
                or 'native_target_slot_unconfirmed');return
        end
        observed(attempt.status)
    end
    function M.step()
        if not M.enabled then return end
        M.ticks=M.ticks+1;M.total_ticks=M.total_ticks+1
        if M.ticks%5==1 then pcall(all_upgrades.step) end
        if config.max_ticks>0 and M.ticks>config.max_ticks then M.enabled=false;report('trial_timeout');return end
        for _,ui in pairs(M.uis) do if ui.check_status then pcall(ui.check_status,M.ticks) end end
        if M.ticks==1 or M.ticks%20==0 then
            for _,ui in pairs(M.uis) do
                local ok=pcall(ui.install)
                if ok and ui.prepare then pcall(ui.prepare) end
            end
            pcall(workshop.install)
            pcall(settings.install)
            pcall(vehicles.install)
            pcall(kills.install,M.controller)
        end
        local dumped,dumpError=pcall(vehicle_dump.step)
        if not dumped then vehicle_dump.diagnostics.status='vehicle_dump_error';vehicle_dump.diagnostics.error=tostring(dumpError):sub(1,480) end
        local killed,killError=pcall(kills.step)
        if not killed then kills.diagnostics.status='kill_adapter_error';kills.diagnostics.error=tostring(killError):sub(1,480) end
        if not local_controller(M.controller) then report('local_controller_not_ready');return end
        if M.features.cosmetics or M.features.emotes then
            pcall(cosmetics.install)
            if (cosmetics.diagnostics.status==nil or cosmetics.diagnostics.status=='cosmetic_item_enumeration_unavailable')
                and M.ticks%100==0 then pcall(cosmetics.start) end
            pcall(cosmetics.step)
        end
        if M.total_ticks%3==0 or in_lobby() then
            local ok,err=pcall(sync_live_ui)
            if not ok then access.diagnostics.status='live_ui_adapter_error';access.diagnostics.last_error=tostring(err):sub(1,480) end
        end
        local lobbyOk,lobbyError=true,nil
        if M.features.lobby then lobbyOk,lobbyError=pcall(lobby.tick) end
        if not lobbyOk then
            lobby.diagnostics.status='lobby_preview_adapter_error'
            lobby.diagnostics.last_error=tostring(lobbyError):sub(1,480)
        end
        local ok,pawn=method(M.controller,'GetCurPlayerCharacter')
        if not ok or not valid(pawn) then ok,pawn=method(M.controller,'GetCurPawn') end
        equipped=setmetatable({},{__mode='k'})
        if not ok or not valid(pawn) then
            if in_lobby() and M.total_ticks%5==0 then pcall(cosmetics.sync) end
            animated.clear();report('pawn_not_ready');return
        end
        local candidates,seen={},{}
        local function add(w)
            if valid(w) and not seen[w] then seen[w]=true;candidates[#candidates+1]=w end
        end
        local currentOk,current=method(pawn,'GetCurrentWeapon');if currentOk then add(current) end
        local managerOk,manager=method(pawn,'GetWeaponManager')
        local inventory={api_available=false,candidate_count=0,matching_m416_count=0,matching_aug_count=0}
        if managerOk and valid(manager) then
            local listed,list=method(manager,'GetAllInventoryWeaponList',true)
            if listed and list~=nil then
                local counted,n=method(list,'Num')
                if counted then
                    if type(n)=='number' and n>=0 and n<=32 and n==math.floor(n) then
                        inventory.api_available=true
                        for index=0,n-1 do local read,w=method(list,'Get',index);if read then add(w) end end
                    end
                elseif type(list)=='table' and #list<=32 then
                    inventory.api_available=true
                    for _,w in ipairs(list) do add(w) end
                end
            end
        end
        inventory.candidate_count=#candidates
        M.inventory=inventory
        local owned={};local matching=0;local weapons_ready=true
        for _,w in ipairs(candidates) do
            local got,base=method(w,'GetWeaponID')
            if got and byBase[base] then
                matching=matching+1
                local ownOk,isOwn=method(member(w,'WeaponAvatarComponent'),'IsSelf')
                if ownOk and isOwn==true then owned[base]=true;equipped[w]=true end
                if base==101004 then inventory.matching_m416_count=inventory.matching_m416_count+1 end
                if base==101006 then inventory.matching_aug_count=inventory.matching_aug_count+1 end
                if M.features.weapons then
                    process_weapon(w)
                    local snap=Weapon.inspect({weapon=w,is_valid=valid},base)
                    local target=M.selected_ids[base]
                    if target and (snap.slot_skin_id~=target or snap.entity_skin_id~=target
                        or snap.all_mesh_loaded~=true or not snap.mesh_valid) then weapons_ready=false end
                end
            end
        end
        local delay=math.max(1,math.ceil(((config.cosmetic_options or {}).delay_after_weapons_seconds or 0.1)
            /(config.poll_interval or 0.1)))
        if M.features.weapons and not weapons_ready then
            cosmetic_weapons_ready=false;cosmetic_ready_tick=math.huge
        elseif not cosmetic_weapons_ready then
            cosmetic_weapons_ready=true;cosmetic_ready_tick=M.total_ticks+delay
        end
        if M.features.cosmetics and M.total_ticks%5==0 then pcall(cosmetics.sync) end
        local vehicleOK,vehicleError=pcall(vehicles.step,pawn,M.controller)
        if not vehicleOK then vehicles.diagnostics.status='vehicle_adapter_error';vehicles.diagnostics.error=tostring(vehicleError):sub(1,480) end
        local mounted=vehicles.diagnostics.mounted_base_id
        if mounted and M.menu_vehicle_base~=mounted then
            M.menu_vehicle_base=mounted
        elseif not mounted then M.menu_vehicle_base=nil end
        if M.features.backpack and M.total_ticks%3==0 then
            local beforeStatus,beforeRequests=panel.diagnostics.status,panel.diagnostics.requests
            local panelOk,panelError=pcall(panel.sync,M.controller,pawn,M.total_ticks,M.selected_ids,owned)
            if not panelOk then
                panel.diagnostics.status='backpack_panel_adapter_error'
                panel.diagnostics.last_error=tostring(panelError):sub(1,480)
            end
            if beforeStatus~=panel.diagnostics.status or beforeRequests~=panel.diagnostics.requests then
                report('backpack_ui_updated',true,true)
            end
        end
        if matching==0 then
            report(#candidates==0 and 'M416_AUG_not_in_equipment_yet' or 'waiting_for_supported_weapon')
        end
    end
    local function run(c)
        M.generation=M.generation+1
        local generation=M.generation
        local function tick()
            if generation~=M.generation or not M.enabled then return end
            M.step()
            if M.enabled and generation==M.generation then
                if not defer(c,config.poll_interval or 0.25,tick) then M.enabled=false;report('timer_unavailable') end
            end
        end
        if not defer(c,config.poll_interval or 0.25,tick) then M.enabled=false;report('timer_unavailable') end
    end
    function M.start()
        if not M.core then report(M.storage_error or 'storage_unavailable');return false end
        if not local_controller(M.controller) then report('local_controller_not_ready');return false end
        if config.persist_selection~=true then
            if not config.upgrade_only then
                for base,id in pairs(M.selected_ids) do
                    local selected,why=M.core:select_session('weapon',base,id)
                    if not selected then report(why or 'session_selection_failed');return false end
                end
            end
            M.selection_mode='session_only';M.selection_error=nil
        elseif not M.restored then
            local saved,err=M.core:select('weapon',config.trial_base_id,config.trial_skin_id)
            if not saved then
                M.selection_error=err or 'selection_save_failed'
                report(M.selection_error,true)
                local selected,why=M.core:select_session('weapon',config.trial_base_id,config.trial_skin_id)
                if not selected then report(why or 'session_selection_failed');return false end
                M.selection_mode='session_only'
            else M.selection_mode='saved_verified';M.selection_error=nil end
        else
            M.selection_mode='restored';M.selection_error=nil
        end
        M.enabled=true;M.ticks=0
        for base,ui in pairs(M.uis) do
            if ui.begin then pcall(ui.begin) end
            local installed=pcall(ui.install)
            if not installed then ui.diagnostics.install_error=true end
            if installed and ui.prepare then pcall(ui.prepare) end
            if config.upgrade_only and ui.prepared and not ui.by_skin[M.selected_ids[base]] then
                M.choose_skin(ui.prepared[1].id,base,false)
            end
        end
        pcall(workshop.install)
        pcall(access.install);pcall(settings.install);pcall(vehicles.install);pcall(collection.install)
        pcall(cosmetics.install);pcall(cosmetics.start)
        if config.vehicle_dump_on_start then pcall(vehicle_dump.start) end
        pcall(kills.install,M.controller)
        local skin=M.selected_ids[M.target_base_id]
        if skin and M.features.lobby then lobby.preview(skin,M.target_base_id) end
        state.save()
        report(M.selection_mode=='session_only' and 'trial_started_session_only' or 'trial_started')
        run(M.controller);return M.enabled
    end
    function M.stop()
        M.enabled=false;M.generation=M.generation+1
        projection.clear();collection.clear();panel.clear();vehicles.clear()
        cosmetics.clear();parts.clear()
        report('trial_stopped')
        -- Does not claim to revert an already-applied appearance.
    end
    local function prepare_settings()
        local called,registered=pcall(settings.install)
        M.startup.settings_registered=called and registered==true
        if M.startup.settings_registered then
            report('settings_registered_open_native_settings',true,true)
        else report('settings_native_factory_not_ready',true,true) end
    end
    local function accept_controller(c)
        if not local_controller(c) then return false end
        local changed=M.controller~=c
        M.controller=c
        M.startup.local_controller_confirmed=true
        if M.enabled and changed then pcall(kills.install,c);M.ticks=0;run(c) end
        return true
    end
    local bootstrapped=setmetatable({},{__mode='k'})
    local function on_controller(c)
        if c==nil then report('controller_nil');return end
        if accept_controller(c) then prepare_settings() end
        if bootstrapped[c] then return end
        bootstrapped[c]=true
        local scheduled=0
        for _,delay in ipairs({2,5,15,30}) do
            if defer(c,delay,function()
                M.startup.bootstrap_callback_ran=true
                if accept_controller(c) then
                    prepare_settings()
                else report('controller_locality_not_ready',true,true) end
            end,true) then scheduled=scheduled+1 end
        end
        M.startup.scheduled_callbacks=scheduled
        report(scheduled>0 and 'bootstrap_scheduled' or 'bootstrap_timer_unavailable',true,true)
    end
    function M.attach(class)
        if type(class)~='table' or type(class.ReceiveBeginPlay)~='function' then
            M.startup.hook_installed=false;report('controller_hook_unavailable');return
        end
        if hooked[class] then return end
        local original=class.ReceiveBeginPlay
        class.ReceiveBeginPlay=function(self,...)
            local results=table.pack(original(self,...))
            M.startup.begin_play_seen=true
            local ok=pcall(on_controller,self)
            if not ok then report('controller_bootstrap_error') end
            return table.unpack(results,1,results.n)
        end
        hooked[class]=true
        M.startup.hook_installed=true
    end
    M.startup.slua_validator_available=slua~=nil and type(slua.isValid)=='function'
    M.startup.engine_validator_available=type(engine_validator)=='function'
    report('loaded_waiting_for_controller')
    M.attach(controller_class)
    if Game and type(Game.GetLocalPlayerController)=='function' then
        local ok,c=pcall(Game.GetLocalPlayerController,Game)
        M.startup.initial_controller_found=ok and c~=nil
        if ok and c~=nil then on_controller(c) else report('awaiting_controller_begin_play',true) end
    else M.startup.initial_controller_found=false;report('awaiting_controller_begin_play',true) end
    return M
end
Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_565.Icon_256_Helmet_Lv3_int_565","cosmetic"},{1502003517,9,5,502,6,"M\197\169 Gi\195\161p C\225\186\173u V\195\160ng Ph\198\176\225\187\163t Th\225\187\167 (C\225\186\165p 3)","/Game/res/IG4600/Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_566.Icon_256_Helmet_Lv3_int_566","cosmetic"},{1502003518,9,5,502,7,"M\197\169 Gi\195\161p Saitama (C\225\186\165p 3)","/Game/Res/IG4600/Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_569.Icon_256_Helmet_Lv3_int_569","cosmetic"},{1502003519,9,5,502,6,"M\197\169 Gi\195\161p Ng\198\176u Ma (C\225\186\165p 3)","/Game/res/IG4600/Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_567.Icon_256_Helmet_Lv3_int_567","cosmetic"},{1502003520,9,5,502,6,"M\197\169 Gi\195\161p Quang Ph\225\187\149 (C\225\186\165p 3)","/Game/res/IG4600/Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_563.Icon_256_Helmet_Lv3_int_563","cosmetic"},{1502003521,9,5,502,6,"M\197\169 Gi\195\161p B.Duck \196\144\195\161ng Y\195\170u (C\225\186\165p 3)","/Game/Res/IG4600/Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_571.Icon_256_Helmet_Lv3_int_571","cosmetic"},{1502003522,9,5,502,6,"M\197\169 Gi\195\161p S\225\186\175t (C\225\186\165p 3)","/Game/res/IG4600/Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_573.Icon_256_Helmet_Lv3_int_573","cosmetic"},{1502003523,9,5,502,7,"M\197\169 Gi\195\161p Ng\225\187\141c Thi\195\170n Y\225\186\191t (C\225\186\165p 3)","/Game/res/IG4600/Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_572.Icon_256_Helmet_Lv3_int_572","cosmetic"},{1502003524,9,5,502,6,"M\197\169 Gi\195\161p Di\225\187\135t Vong (C\225\186\165p 3)","/Game/res/IG4600/Arts/UI/TableIcons/ItemIcon/Equipment_Big/Icon_256_Helmet_Lv3_int_570.Icon_256_Helmet_Lv3_int_570","cosmetic"},{1502003525,9,5,502,6,"M\197\169 Gi\195\161p D\225\186\161 Ti\225\187\135c (C\225\186\165p 3)","/Game/res/IG46